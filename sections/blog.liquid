<section class="full-width"><header class="db-page-hero"><div class="db-page"><p class="db-kicker">Notes from the studio</p><h1 class="db-title">{{ blog.title }}</h1></div></header><div class="db-page db-section">{%- paginate blog.articles by 12 -%}<div class="db-blog-grid">{%- for article in blog.articles -%}<article class="db-article-card">{%- if article.image -%}<a href="{{ article.url }}">{{ article.image | image_url: width: 900 | image_tag: widths: '400,650,900', loading: 'lazy', alt: article.title }}</a>{%- endif -%}<p class="db-kicker">{{ article.published_at | date: '%B %d, %Y' }}</p><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p></article>{%- endfor -%}</div>{%- render 'pagination', paginate: paginate -%}{%- endpaginate -%}</div></section>
{% schema %}{ "name": "Editorial blog", "settings": [] }{% endschema %}
