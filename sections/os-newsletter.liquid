{% render 'os-section-style', section: section %}
<section class="db-statement full-width db-section-layout" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};padding-block:0">{% render 'os-section-background', section: section %}<div class="db-section-shell db-section-shell--{{ section.settings.content_width }}"><p class="db-kicker">{{ section.settings.eyebrow }}</p><h2 class="db-title">{{ section.settings.heading }}</h2><div style="max-width:600px;margin:36px auto 0">{%- form 'customer', class: 'db-search-form' -%}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">→</button>{%- endform -%}</div></div></section>
{% schema %}{ "name": "Editorial newsletter", "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in bloom" }, { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A little delight, <em>straight to your inbox.</em>" }, { "type": "color", "id": "background", "label": "Background", "default": "#efc9c5" },{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"image_picker","id":"mobile_background_image","label":"Mobile background image","info":"Uses the desktop background image when empty."},{"type":"select","id":"content_width","label":"Content width","default":"contained","options":[{"value":"contained","label":"Container"},{"value":"fluid","label":"Container fluid"},{"value":"full","label":"Full width"},{"value":"custom","label":"Custom width"}]},{"type":"range","id":"custom_width","label":"Custom width","min":600,"max":2000,"step":20,"unit":"px","default":1200},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":120},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":120},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":88},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":88},{"type":"range","id":"margin_top","label":"Desktop top margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_top","label":"Mobile top margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0}, { "type": "color", "id": "text_color", "label": "Text", "default": "#193e36" }], "presets": [{ "name": "Editorial newsletter" }] }{% endschema %}
