{% render 'os-section-style', section: section %}
<section class="os-press full-width db-section-layout" style="--os-press-bg:{{ section.settings.background }};--os-press-text:{{ section.settings.text_color }};--os-press-accent:{{ section.settings.accent }};--os-press-width:{{ section.settings.content_width }}px">
  {% render 'os-section-background', section: section %}
  <div class="os-press__inner">
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    <div class="os-press__grid">
      {%- for block in section.blocks -%}
        <article class="os-press-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '360,540,720,1000', sizes: '(min-width:990px) 33vw, (min-width:600px) 50vw, 100vw', loading: 'lazy', alt: block.settings.title }}</a>{%- endif -%}
          <div><h2>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.title }}</a>{%- else -%}{{ block.settings.title }}{%- endif -%}</h2>{%- if block.settings.date != blank -%}<time>{{ block.settings.date }}</time>{%- endif -%}<div class="db-rte">{{ block.settings.text }}</div></div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.contact_text != blank -%}<div class="os-press__contact db-rte">{{ section.settings.contact_text }}</div>{%- endif -%}
  </div>
</section>
{% stylesheet %}
.os-press{background:var(--os-press-bg);color:var(--os-press-text);padding:var(--db-section-pad-top) 24px var(--db-section-pad-bottom)}
.os-press__inner{margin:auto;max-width:var(--os-press-width)}
.os-press h1{color:var(--os-press-accent);font-family:var(--db-display);font-size:46px;font-weight:400;margin:0 0 60px;text-align:center}
.os-press__grid{display:grid;gap:55px 42px;grid-template-columns:repeat(3,minmax(0,1fr))}
.os-press-card img{aspect-ratio:1.45;border-radius:10px;margin-bottom:20px;object-fit:cover;width:100%}
.os-press-card h2{font-family:var(--db-display);font-size:22px;font-weight:700;line-height:1.2;margin:0 0 8px}
.os-press-card h2 a{color:inherit;text-decoration:none}
.os-press-card time{display:block;font-style:italic;margin-bottom:12px}
.os-press-card .db-rte{line-height:1.65}
.os-press__contact{border-top:1px solid currentColor;margin-top:70px;padding-top:34px;text-align:center}
@media (max-width: 749px) {
  .os-press{padding:55px 20px 70px}
  .os-press h1{font-size:38px;margin-bottom:40px}
  .os-press__grid{grid-template-columns:1fr}
}
{% endstylesheet %}

{% schema %}
{"name":"OS press page","settings":[{"type":"text","id":"heading","label":"Heading","default":"PRESS"},{"type":"range","id":"content_width","label":"Content width","min":800,"max":1600,"step":20,"unit":"px","default":1200},{"type":"richtext","id":"contact_text","label":"Press contact"},{"type":"color","id":"background","label":"Background","default":"#f9f5ef"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"image_picker","id":"mobile_background_image","label":"Mobile background image","info":"Uses the desktop background image when empty."},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":80},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":100},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":52},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":72},{"type":"range","id":"margin_top","label":"Desktop top margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_top","label":"Mobile top margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"color","id":"text_color","label":"Text","default":"#404d1c"},{"type":"color","id":"accent","label":"Accent","default":"#8f2343"}],"blocks":[{"type":"article","name":"Press item","settings":[{"type":"image_picker","id":"image","label":"Image or logo"},{"type":"text","id":"title","label":"Title"},{"type":"text","id":"date","label":"Date"},{"type":"richtext","id":"text","label":"Summary"},{"type":"url","id":"link","label":"Article link"}]}],"presets":[{"name":"OS press page"}]}
{% endschema %}
