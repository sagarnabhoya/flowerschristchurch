<section class="db-statement full-width" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="db-page"><p class="db-kicker">{{ section.settings.eyebrow }}</p><h2 class="db-title">{{ section.settings.heading }}</h2><div style="max-width:600px;margin:36px auto 0">{%- form 'customer', class: 'db-search-form' -%}<input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" placeholder="Your email address" required><button type="submit">→</button>{%- endform -%}</div></div></section>
{% schema %}{ "name": "Editorial newsletter", "settings": [{ "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in bloom" }, { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A little delight, <em>straight to your inbox.</em>" }, { "type": "color", "id": "background", "label": "Background", "default": "#efc9c5" }, { "type": "color", "id": "text_color", "label": "Text", "default": "#193e36" }], "presets": [{ "name": "Editorial newsletter" }] }{% endschema %}
