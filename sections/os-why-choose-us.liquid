{%- render 'os-section-style', section: section -%}
<section class="os-why full-width db-section-layout" style="--os-why-bg:{{ section.settings.background }};--os-why-card:{{ section.settings.card_color }};--os-why-text:{{ section.settings.text_color }};--os-why-accent:{{ section.settings.accent_color }}">
  {% render 'os-section-background', section: section %}
  <div class="db-section-shell db-section-shell--{{ section.settings.content_width }}">
    <div class="os-why__frame">
      <header class="os-why__header">
        <div class="os-why__heading">
          {%- if section.settings.eyebrow != blank -%}<p class="db-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        </div>
        <div class="os-why__summary">
          {%- if section.settings.intro != blank -%}<div class="db-rte">{{ section.settings.intro }}</div>{%- endif -%}
          {%- if section.settings.button_label != blank -%}<a class="os-why__link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
        </div>
        <svg class="os-why__flower" aria-hidden="true" viewBox="0 0 180 220" fill="none">
          <g class="os-why__flower-sway">
            <g class="os-why__flower-stem">
              <path d="M91 207c1-42 0-83-3-124"/>
              <path d="M89 143c-23-2-39-14-47-36 23-1 39 11 47 36ZM90 166c20-3 34-15 40-36-21 1-35 13-40 36Z"/>
            </g>
            <g class="os-why__flower-bloom">
              <ellipse cx="89" cy="52" rx="17" ry="31"/>
              <ellipse cx="89" cy="52" rx="17" ry="31" transform="rotate(72 89 52)"/>
              <ellipse cx="89" cy="52" rx="17" ry="31" transform="rotate(144 89 52)"/>
              <ellipse cx="89" cy="52" rx="17" ry="31" transform="rotate(216 89 52)"/>
              <ellipse cx="89" cy="52" rx="17" ry="31" transform="rotate(288 89 52)"/>
              <circle cx="89" cy="52" r="10"/>
            </g>
          </g>
        </svg>
      </header>

      <os-why-slider>
      <div class="os-why__list{% unless section.settings.show_numbers %} os-why__list--no-numbers{% endunless %}" data-why-track>
        {%- for block in section.blocks -%}
          <article class="os-why__item" {{ block.shopify_attributes }}>
            <div class="os-why__item-top">
              {%- if section.settings.show_numbers -%}<span class="os-why__number">{{ forloop.index | prepend: '0' }}</span>{%- endif -%}
              {%- if block.settings.icon != blank -%}<div class="os-why__icon">{{ block.settings.icon | image_url: width: 120 | image_tag: width: 48, loading: 'lazy', alt: '' }}</div>{%- else -%}<span class="os-why__mark" aria-hidden="true">✦</span>{%- endif -%}
            </div>
            <div class="os-why__copy">
              {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
            </div>
            <span class="os-why__rule" aria-hidden="true"></span>
          </article>
        {%- endfor -%}
      </div>
      <div class="os-why__controls" aria-label="Why choose us slider controls">
        <button type="button" aria-label="Previous reason" data-why-prev>←</button>
        <div class="os-why__progress" aria-hidden="true"><span data-why-progress></span></div>
        <span class="os-why__status" aria-live="polite"><b data-why-current>01</b> / <span>{{ section.blocks.size | prepend: '0' }}</span></span>
        <button type="button" aria-label="Next reason" data-why-next>→</button>
      </div>
      </os-why-slider>
    </div>
  </div>
</section>
{% schema %}
{"name":"Why choose us","settings":[{"type":"header","content":"Section layout"},{"type":"select","id":"content_width","label":"Content width","default":"custom","options":[{"value":"contained","label":"Container"},{"value":"fluid","label":"Container fluid"},{"value":"full","label":"Full width"},{"value":"custom","label":"Custom width"}]},{"type":"range","id":"custom_width","label":"Custom width","min":600,"max":2000,"step":20,"unit":"px","default":1540},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":88},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":88},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"image_picker","id":"mobile_background_image","label":"Mobile background image","info":"Uses the desktop background image when empty."},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":88},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":88},{"type":"range","id":"margin_top","label":"Desktop top margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_top","label":"Mobile top margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The local difference"},{"type":"text","id":"heading","label":"Heading","default":"Why Christchurch chooses us."},{"type":"richtext","id":"intro","label":"Introduction","default":"<p>Thoughtful flowers should feel personal. From the market to their doorstep, our local team handles every order with care.</p>"},{"type":"checkbox","id":"show_numbers","label":"Show item numbers","default":true},{"type":"text","id":"button_label","label":"Button label","default":"Shop local flowers"},{"type":"url","id":"button_link","label":"Button link"},{"type":"header","content":"Colours"},{"type":"color","id":"background","label":"Background","default":"#f7f0e7"},{"type":"color","id":"card_color","label":"Card background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Text","default":"#bb3f4b"},{"type":"color","id":"accent_color","label":"Accent","default":"#da8f96"}],"blocks":[{"type":"reason","name":"Reason","settings":[{"type":"image_picker","id":"icon","label":"Optional icon"},{"type":"text","id":"heading","label":"Heading","default":"Fresh Flowers Daily"},{"type":"textarea","id":"text","label":"Text","default":"We pick flowers from the local Flower Market for unbeatable freshness."}]}],"max_blocks":8,"presets":[{"name":"Why choose us","blocks":[{"type":"reason"},{"type":"reason"},{"type":"reason"}]}]}
{% endschema %}
