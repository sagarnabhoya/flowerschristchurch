<section class="db-hero db-hero--{{ section.settings.layout }} full-width" style="--db-hero-height:{{ section.settings.desktop_height }}px;--db-hero-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
  {%- if section.settings.layout == 'campaign' -%}
    {%- assign fallback_hero_image = collections.all.products.first.featured_image -%}
    <div class="db-hero__campaign-media">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'db-hero__video db-hero__video--desktop', image_size: '2400x' }}
        {%- if section.settings.mobile_video != blank -%}{{ section.settings.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', class: 'db-hero__video db-hero__video--mobile', image_size: '1000x' }}{%- endif -%}
      {%- elsif section.settings.image -%}
        <picture>{%- if section.settings.mobile_image -%}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{%- endif -%}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '800,1200,1600,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}</picture>
      {%- elsif fallback_hero_image -%}{{ fallback_hero_image | image_url: width: 2200 | image_tag: widths: '800,1200,1600,2200', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
      {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
    </div>
    <div class="db-hero__campaign-shade"></div>
    {%- if section.settings.show_content -%}
      <div class="db-hero__campaign-content">
        {%- if section.settings.eyebrow != blank -%}<p class="db-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h1 class="db-title">{{ section.settings.heading }}</h1>
        {%- if section.settings.copy != blank -%}<div class="db-copy">{{ section.settings.copy }}</div>{%- endif -%}
      </div>
    {%- else -%}<h1 class="visually-hidden">{{ section.settings.heading | strip_html }}</h1>{%- endif -%}
    {%- if section.settings.button_label != blank -%}<a class="db-hero__campaign-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
    {%- if section.settings.badge != blank -%}<span class="db-hero__badge">{{ section.settings.badge }}</span>{%- endif -%}
  {%- else -%}
  <div class="db-hero__grid">
    <div class="db-hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="db-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="db-title">{{ section.settings.heading }}</h1>
      {%- if section.settings.copy != blank -%}<div class="db-copy">{{ section.settings.copy }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="db-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} {% render 'icon', name: 'arrow', class: 'db-header__icon' %}</a>{%- endif -%}
    </div>
    <div class="db-hero__media">
      {%- assign fallback_hero_image = collections.all.products.first.featured_image -%}
      {%- if section.settings.image -%}
        <picture>{%- if section.settings.mobile_image -%}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{%- endif -%}{{ section.settings.image | image_url: width: 2200 | image_tag: widths: '800,1200,1600,2200', sizes: '(min-width:750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}</picture>
      {%- elsif fallback_hero_image -%}{{ fallback_hero_image | image_url: width: 1800 | image_tag: widths: '700,1000,1400,1800', sizes: '(min-width:750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
      {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
      {%- if section.settings.badge != blank -%}<span class="db-hero__badge">{{ section.settings.badge }}</span>{%- endif -%}
    </div>
  </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Bloom hero",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "campaign", "options": [{ "value": "campaign", "label": "Full-width campaign" }, { "value": "split", "label": "Split editorial" }] },
    { "type": "video", "id": "video", "label": "Desktop campaign video", "info": "Use a short, muted, owned or licensed Shopify-hosted video." },
    { "type": "video", "id": "mobile_video", "label": "Mobile campaign video", "info": "Optional portrait crop. The desktop video is used when this is empty." },
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "range", "id": "desktop_height", "label": "Desktop image height", "min": 520, "max": 900, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 10 },
    { "type": "checkbox", "id": "show_content", "label": "Show heading and text over image", "default": false },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Seasonal flowers arranged by hand" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made fresh every day" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Flowers to make <em>the daily delightful.</em>" },
    { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Thoughtful seasonal blooms, handcrafted by local florists and delivered with care.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all blooms" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "Handmade by local florists" },
    { "type": "color", "id": "background", "label": "Background", "default": "#efc9c5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#193e36" }
  ],
  "presets": [{ "name": "Bloom hero" }]
}
{% endschema %}
