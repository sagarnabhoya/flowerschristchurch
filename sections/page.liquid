{%- liquid
  assign is_contact = false
  assign is_faq = false
  assign is_delivery = false
  assign is_policy = false
  if page.handle == 'contact'
    assign is_contact = true
  elsif page.handle contains 'faq'
    assign is_faq = true
  elsif page.handle contains 'delivery'
    assign is_delivery = true
  elsif page.handle contains 'policy'
    assign is_policy = true
  endif
-%}
<section class="db-inner-page full-width db-inner-page--{{ page.handle }}">
  {%- if section.settings.show_header -%}
    <header class="db-inner-hero"><div class="db-page"><p class="db-kicker">{%- if is_contact -%}We are here to help{%- elsif is_faq -%}Good to know{%- elsif is_delivery -%}From our studio to their door{%- elsif is_policy -%}The important details{%- else -%}{{ section.settings.eyebrow }}{%- endif -%}</p><h1 class="db-title">{{ page.title }}</h1></div></header>
  {%- endif -%}
  {%- if is_contact -%}
    <div class="db-page db-contact-layout db-section">
      <div class="db-contact-intro"><p class="db-kicker">Say hello</p><h2>Let’s get the conversation <em>blossoming.</em></h2><div class="db-rte">{{ page.content }}</div>{%- if section.settings.contact_email != blank -%}<a class="db-contact-link" href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>{%- endif -%}{%- if section.settings.contact_phone != blank -%}<a class="db-contact-link" href="tel:{{ section.settings.contact_phone | remove: ' ' }}">{{ section.settings.contact_phone }}</a>{%- endif -%}</div>
      <div class="db-contact-card">{%- form 'contact' -%}{%- if form.posted_successfully? -%}<p class="db-form-message" tabindex="-1">Thanks for reaching out. We’ll be in touch shortly.</p>{%- endif -%}{%- if form.errors -%}<div class="db-form-message db-form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}<div class="db-field-row"><label for="ContactName-{{ section.id }}">Name</label><input id="ContactName-{{ section.id }}" name="contact[name]" type="text" value="{{ form.name }}" autocomplete="name"></div><div class="db-field-row"><label for="ContactEmail-{{ section.id }}">Email</label><input id="ContactEmail-{{ section.id }}" name="contact[email]" type="email" value="{{ form.email }}" autocomplete="email" required></div><div class="db-field-row"><label for="ContactPhone-{{ section.id }}">Phone <span>Optional</span></label><input id="ContactPhone-{{ section.id }}" name="contact[phone]" type="tel" value="{{ form.phone }}" autocomplete="tel"></div><div class="db-field-row"><label for="ContactMessage-{{ section.id }}">How can we help?</label><textarea id="ContactMessage-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body }}</textarea></div><button class="db-button" type="submit">Send enquiry {% render 'icon', name: 'arrow', class: 'db-header__icon' %}</button>{%- endform -%}</div>
    </div>
  {%- elsif is_faq or is_delivery -%}
    <div class="db-page db-content-layout db-section"><article class="db-rte db-content-layout__main">{{ page.content }}</article><aside class="db-help-card"><p class="db-kicker">Still wondering?</p><h2>We’re happy to help.</h2><p>Our local team can help with delivery timing, flower care and choosing the right gift.</p><a class="db-button db-button--outline" href="{{ section.settings.help_link | default: pages['contact'].url }}">{{ section.settings.help_label }} {% render 'icon', name: 'arrow', class: 'db-header__icon' %}</a></aside></div>
  {%- elsif is_policy -%}
    <article class="db-policy db-page db-section"><div class="db-rte">{{ page.content }}</div></article>
  {%- else -%}
    <article class="db-standard-page db-page db-section"><div class="db-rte">{{ page.content }}</div></article>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Editorial page",
  "settings": [
    { "type": "checkbox", "id": "show_header", "label": "Show page header", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Default eyebrow", "default": "From our flower studio" },
    { "type": "text", "id": "contact_email", "label": "Contact email" },
    { "type": "text", "id": "contact_phone", "label": "Contact phone" },
    { "type": "text", "id": "help_label", "label": "Help button label", "default": "Contact our team" },
    { "type": "url", "id": "help_link", "label": "Help button link" }
  ]
}
{% endschema %}
