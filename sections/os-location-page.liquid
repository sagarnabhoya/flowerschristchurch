{%- assign featured_collection = section.settings.collection | default: collections.all -%}
{% render 'os-section-style', section: section %}
<article class="os-page-location full-width db-section-layout db-section-layout--content-{{ section.settings.content_width }}" style="background:{{ section.settings.background }};padding-block:var(--db-section-pad-top) var(--db-section-pad-bottom)">
  {% render 'os-section-background', section: section %}
  <header class="db-location-hero"><div class="db-page db-location-hero__grid"><div class="db-location-hero__content"><p class="db-kicker">{{ section.settings.eyebrow }}</p><h1 class="db-title">{{ page.title }}</h1><p class="db-copy">{{ section.settings.intro | replace: '[location]', page.title | remove: 'Flower Delivery to ' | remove: ' Florist' }}</p><a class="db-button" href="{{ featured_collection.url }}">{{ section.settings.button_label }}</a></div><div class="db-location-hero__media">{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '700,1000,1300,1600', sizes: '(min-width:750px) 50vw, 100vw', loading: 'eager', alt: page.title }}{%- else -%}{{ featured_collection.products.first.featured_image | image_url: width: 1400 | image_tag: widths: '700,1000,1400', sizes: '(min-width:750px) 50vw, 100vw', loading: 'eager', alt: page.title }}{%- endif -%}</div></div></header>
  <section class="db-page db-section os-page-location__content"><div class="db-rte">{{ page.content }}</div></section>
  {%- if section.settings.show_products and featured_collection.products_count > 0 -%}<section class="db-page db-section"><div class="db-section-head"><div><p class="db-kicker">Fresh from our florist</p><h2 class="db-title">Popular flowers for local delivery.</h2></div></div><ul class="db-product-grid" role="list">{%- for product in featured_collection.products limit: section.settings.product_limit -%}<li>{% render 'product-card', product: product %}</li>{%- endfor -%}</ul></section>{%- endif -%}
  {%- if section.settings.locations_menu != blank -%}<section class="db-location-directory full-width"><div class="db-page"><p class="db-kicker">Nearby delivery areas</p><h2 class="db-title">Flower delivery across <em>Christchurch.</em></h2><div class="db-location-directory__grid">{%- for link in section.settings.locations_menu.links -%}<a href="{{ link.url }}">{{ link.title }} <span>→</span></a>{%- endfor -%}</div></div></section>{%- endif -%}
</article>
{% schema %}
{"name":"Location page","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Local delivery, made personal"},{"type":"textarea","id":"intro","label":"Fallback introduction","default":"Fresh, thoughtful flowers arranged locally and delivered with care to [location]."},{"type":"text","id":"button_label","label":"Button label","default":"Shop flowers"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"color","id":"background","label":"Section background","default":"#fffaf3"},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"image_picker","id":"mobile_background_image","label":"Mobile background image","info":"Uses the desktop background image when empty."},{"type":"select","id":"content_width","label":"Content width","default":"contained","options":[{"value":"contained","label":"Container"},{"value":"fluid","label":"Container fluid"},{"value":"full","label":"Full width"},{"value":"custom","label":"Custom width"}]},{"type":"range","id":"custom_width","label":"Custom width","min":600,"max":2000,"step":20,"unit":"px","default":1440},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_top","label":"Desktop top margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_top","label":"Mobile top margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"collection","id":"collection","label":"Featured collection"},{"type":"checkbox","id":"show_products","label":"Show featured products","default":true},{"type":"range","id":"product_limit","label":"Products","min":2,"max":8,"step":1,"default":4},{"type":"link_list","id":"locations_menu","label":"Locations menu"}],"presets":[{"name":"Location page"}]}
{% endschema %}
