{% render 'db-section-style', section: section %}
<section class="db-benefits full-width" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
  <div class="db-section-shell db-section-shell--{{ section.settings.content_width | default: 'contained' }}"><div class="db-benefits__grid">
    {%- for block in section.blocks -%}<div class="db-benefit" {{ block.shopify_attributes }}>
      <div class="db-benefit__icon">{%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 180 | image_tag: widths: '72,120,180', sizes: '72px', loading: 'lazy', alt: '' }}{%- else -%}
        {%- case block.settings.icon_style -%}
          {%- when 'scissors' -%}<svg viewBox="0 0 80 80" aria-hidden="true"><circle cx="19" cy="58" r="8"/><circle cx="37" cy="65" r="8"/><path d="M25 54 57 18M33 58 16 30M34 57l27-1M50 28c3-12 11-16 20-17-1 10-8 17-20 17Zm-5 8c9-2 18 1 24 9-10 4-20 1-24-9Z"/></svg>
          {%- when 'clock' -%}<svg viewBox="0 0 80 80" aria-hidden="true"><path d="M40 7c7 8 13 7 22 9-2 9 2 13 8 19-7 7-6 13-7 22-9 0-14 4-21 10-7-6-13-5-22-7 1-9-3-14-9-21 6-7 5-13 7-22 9 2 14-2 21-8Z"/><circle cx="40" cy="38" r="19"/><path d="M40 24v15l-10 7"/></svg>
          {%- when 'pin' -%}<svg viewBox="0 0 80 80" aria-hidden="true"><path d="M40 72S18 48 18 30a22 22 0 1 1 44 0c0 18-22 42-22 42Z"/><path d="M40 21c5 5 10 3 12 10-6 2-5 8-12 11-6-4-7-9-12-11 3-6 8-6 12-10Z"/></svg>
          {%- when 'cake' -%}<svg viewBox="0 0 80 80" aria-hidden="true"><path d="M16 40h48v27H16zM16 49c8 8 16-8 24 0s16-8 24 0M40 16v15M40 10c6 6 4 11 0 13-4-3-5-7 0-13Z"/></svg>
          {%- else -%}<span aria-hidden="true">{{ block.settings.symbol }}</span>
        {%- endcase -%}
      {%- endif -%}</div>
      <p>{{ block.settings.text }}</p>
    </div>{%- endfor -%}
  </div></div>
</section>
{% schema %}
{
  "name": "Icon benefits",
  "settings": [
    { "type": "color", "id": "background", "label": "Section background", "default": "#fff5f6" }, { "type": "color", "id": "text_color", "label": "Text and icon", "default": "#ef3d32" },
    { "type": "header", "content": "Section layout" },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "contained", "options": [{ "value": "contained", "label": "Container" }, { "value": "fluid", "label": "Container fluid" }, { "value": "full", "label": "Full width" }, { "value": "custom", "label": "Custom width" }] },
    { "type": "range", "id": "custom_width", "label": "Custom width", "min": 600, "max": 2000, "step": 20, "unit": "px", "default": 1280 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }, { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [{ "type": "benefit", "name": "Benefit", "limit": 6, "settings": [{ "type": "image_picker", "id": "icon", "label": "Custom icon image" }, { "type": "select", "id": "icon_style", "label": "Built-in icon", "default": "scissors", "options": [{ "value": "scissors", "label": "Florist scissors" }, { "value": "clock", "label": "Delivery clock" }, { "value": "pin", "label": "Flower location pin" }, { "value": "cake", "label": "Celebration cake" }, { "value": "symbol", "label": "Custom symbol" }] }, { "type": "text", "id": "symbol", "label": "Custom symbol", "default": "✿" }, { "type": "textarea", "id": "text", "label": "Text", "default": "Handmade by florists, different daily." }] }],
  "presets": [{ "name": "Icon benefits", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }]
}
{% endschema %}
