<section class="db-value-strip full-width"><div class="db-page db-value-strip__grid">{%- for block in section.blocks -%}<div class="db-value" {{ block.shopify_attributes }}><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.text }}</span></div>{%- endfor -%}</div></section>
{% schema %}
{
  "name": "Service promises",
  "settings": [],
  "blocks": [{ "type": "promise", "name": "Promise", "limit": 4, "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Handmade daily" }, { "type": "text", "id": "text", "label": "Text", "default": "By local florists" }] }],
  "presets": [{ "name": "Service promises", "blocks": [{ "type": "promise" }, { "type": "promise" }, { "type": "promise" }, { "type": "promise" }] }]
}
{% endschema %}
