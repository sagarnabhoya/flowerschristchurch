{% render 'os-section-style', section: section %}
<section class="os-events full-width db-section-layout" style="--os-events-bg:{{ section.settings.background }};--os-events-soft:{{ section.settings.soft_background }};--os-events-text:{{ section.settings.text_color }};--os-events-accent:{{ section.settings.accent }};--os-events-width:{{ section.settings.content_width }}px;padding-block:var(--db-section-pad-top) var(--db-section-pad-bottom)">
  {% render 'os-section-background', section: section %}
  <div class="os-events__hero">
    <div class="os-events__hero-copy"><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.subheading }}</p></div>
    <picture class="os-events__hero-media">
      {%- if section.settings.mobile_hero != blank -%}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_hero | image_url: width: 900 }}">{%- endif -%}
      {%- if section.settings.hero != blank -%}{{ section.settings.hero | image_url: width: 1800 | image_tag: widths: '750,1100,1500,1800', sizes: '(min-width:750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.heading }}{%- else -%}<span class="os-events__placeholder"></span>{%- endif -%}
    </picture>
  </div>
  <div class="os-events__ready"><h2>{{ section.settings.ready_heading }}</h2><div class="db-rte">{{ section.settings.ready_text }}</div>{%- if section.settings.collection != blank -%}<div class="os-events__products">{%- for product in section.settings.collection.products limit: section.settings.product_limit -%}{% render 'product-card', product: product, show_badges: true, show_secondary_image: settings.card_show_secondary_image, show_description: true %}{%- endfor -%}</div>{%- endif -%}</div>
  <div class="os-events__bespoke-head"><h2>{{ section.settings.bespoke_heading }}</h2><div class="db-rte">{{ section.settings.bespoke_text }}</div></div>
  <div class="os-events__services">{%- for block in section.blocks -%}{%- if block.type == 'service' -%}<a class="os-events__service" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '360,540,720,900', sizes: '(min-width:990px) 25vw, (min-width:600px) 50vw, 100vw', loading: 'lazy', alt: block.settings.heading }}{%- else -%}<span class="os-events__placeholder"></span>{%- endif -%}<h3>{{ block.settings.heading }}</h3><div class="db-rte">{{ block.settings.text }}</div></a>{%- endif -%}{%- endfor -%}</div>
  {%- if section.settings.button_label != blank -%}<div class="os-events__cta"><a href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></div>{%- endif -%}
</section>
{% stylesheet %}
.os-events{background:var(--os-events-bg);color:var(--os-events-text)}
.os-events__hero{background:#eadce8;display:grid;grid-template-columns:1fr 1fr;min-height:250px}
.os-events__hero-copy{align-self:center;padding:45px max(40px,calc((100vw - var(--os-events-width))/2))}
.os-events__hero h1{color:#ed412f;font-family:var(--db-display);font-size:46px;font-weight:400;margin:0 0 14px}
.os-events__hero-copy p{color:#ed412f;font-size:18px;margin:0}
.os-events__hero-media,.os-events__hero-media img,.os-events__placeholder{display:block;height:100%;min-height:250px;width:100%}
.os-events__hero-media img{object-fit:cover}
.os-events__placeholder{background:linear-gradient(135deg,#efdfe9,#f7cdd8)}
.os-events__ready{margin:auto;max-width:1120px;padding:80px 24px 150px;text-align:center}
.os-events h2{color:var(--os-events-accent);font-family:var(--db-display);font-size:32px;font-weight:400;margin:0 0 16px}
.os-events__products{display:grid;gap:22px;grid-template-columns:repeat(3,1fr);margin-top:36px;text-align:left}
.os-events__bespoke-head{padding:0 24px 45px;text-align:center}
.os-events__services{background:var(--os-events-soft);display:grid;gap:70px;grid-template-columns:repeat(4,minmax(0,1fr));padding:70px max(40px,calc((100vw - var(--os-events-width))/2)) 55px}
.os-events__service{color:inherit;min-width:0;text-align:center;text-decoration:none}
.os-events__service img,.os-events__service>.os-events__placeholder{aspect-ratio:.78;border-radius:48% 48% 0 0;min-height:0;object-fit:cover;width:100%}
.os-events__service h3{font-family:var(--db-display);font-size:21px;margin:24px 0 12px}
.os-events__service .db-rte{line-height:1.7}
.os-events__cta{background:var(--os-events-soft);padding:20px 24px 85px;text-align:center}
.os-events__cta a{background:var(--os-events-accent);border-radius:8px;color:#fff;display:inline-block;font-family:var(--db-display);font-size:19px;min-width:300px;padding:18px 32px;text-decoration:none}
@media (max-width: 749px) {
  .os-events__hero{grid-template-columns:1fr}
  .os-events__hero-copy{padding:36px 20px}
  .os-events__hero h1{font-size:38px}
  .os-events__hero-media,.os-events__hero-media img,.os-events__placeholder{min-height:230px}
  .os-events__ready{padding:55px 18px 80px}
  .os-events__products{grid-template-columns:1fr}
  .os-events__services{gap:40px;grid-template-columns:1fr;padding:50px 24px}
  .os-events__service img,.os-events__service>.os-events__placeholder{aspect-ratio:.9}
  .os-events__cta a{min-width:min(300px,100%)}
}
{% endstylesheet %}

