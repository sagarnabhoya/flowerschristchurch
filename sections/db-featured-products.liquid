{% render 'db-section-style', section: section %}
{%- assign featured_collection = section.settings.collection | default: collections.all -%}
<section class="db-spotlight full-width" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
 <div class="db-section-shell db-section-shell--{{ section.settings.content_width | default: 'contained' }}"><div class="db-spotlight__viewport" data-carousel data-start-index="1" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="db-spotlight__track" data-carousel-track>
   {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
    <article class="db-spotlight__slide" data-carousel-slide>
      <a class="db-spotlight__media" href="{{ product.url }}">{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '500,800,1100,1400', sizes: '(min-width: 750px) 38vw, 100vw', loading: 'eager', alt: product.featured_image.alt | default: product.title }}{%- if section.settings.badge_label != blank -%}<span class="db-spotlight__badge">{{ section.settings.badge_label }}</span>{%- endif -%}</a>
      <div class="db-spotlight__content"><h2>{{ product.title }}</h2>{%- if section.settings.show_description and product.description != blank -%}<div class="db-spotlight__description">{{ product.description | strip_html | truncatewords: 28 }}</div>{%- endif -%}<p class="db-spotlight__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</p><a class="db-spotlight__button" href="{{ product.url }}">{{ section.settings.button_label }}</a></div>
    </article>
   {%- else -%}
    <article class="db-spotlight__slide" data-carousel-slide><div class="db-spotlight__media">{{ 'product-1' | placeholder_svg_tag }}</div><div class="db-spotlight__content"><h2>Featured bouquet</h2><p>Choose a collection in the Theme Editor.</p></div></article>
   {%- endfor -%}
  </div>
  <button class="db-carousel-arrow db-carousel-arrow--prev" type="button" data-carousel-prev aria-label="Previous product">&#8249;</button><button class="db-carousel-arrow db-carousel-arrow--next" type="button" data-carousel-next aria-label="Next product">&#8250;</button>
 </div></div>
</section>
{% schema %}
{
 "name": "Product spotlight slider",
 "settings": [
  { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
  { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true }, { "type": "text", "id": "button_label", "label": "Button label", "default": "Order Now" }, { "type": "text", "id": "badge_label", "label": "Image badge", "default": "DB LOVES!" },
  { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true }, { "type": "range", "id": "interval", "label": "Autoplay interval", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
  { "type": "color", "id": "background", "label": "Section background", "default": "#fffbf6" }, { "type": "color", "id": "text_color", "label": "Text", "default": "#41511d" },
  { "type": "header", "content": "Section layout" }, { "type": "select", "id": "content_width", "label": "Content width", "default": "full", "options": [{ "value": "contained", "label": "Container" }, { "value": "fluid", "label": "Container fluid" }, { "value": "full", "label": "Full width" }, { "value": "custom", "label": "Custom width" }] },
  { "type": "range", "id": "custom_width", "label": "Custom width", "min": 600, "max": 2000, "step": 20, "unit": "px", "default": 1600 }, { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }, { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
 ], "presets": [{ "name": "Product spotlight slider" }]
}
{% endschema %}
