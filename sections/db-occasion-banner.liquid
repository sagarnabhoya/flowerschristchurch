{% render 'db-section-style', section: section %}
<section class="db-occasion full-width" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="db-section-shell db-section-shell--{{ section.settings.content_width | default: 'contained' }}"><div class="db-occasion__media" style="--db-banner-height:{{ section.settings.height }}px;--db-banner-overlay:{{ section.settings.overlay | divided_by: 100.0 }}">
 {%- assign fallback_banner_image = collections.all.products[2].featured_image | default: collections.all.products.first.featured_image -%}{%- if section.settings.image != blank -%}<picture>{%- if section.settings.mobile_image != blank -%}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">{%- endif -%}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '800,1200,1800,2400', sizes: '100vw', loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}</picture>{%- elsif fallback_banner_image != blank -%}{{ fallback_banner_image | image_url: width: 2400 | image_tag: widths: '800,1200,1800,2400', sizes: '100vw', loading: 'lazy', alt: section.settings.heading }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
 <div class="db-occasion__overlay"><h2>{{ section.settings.heading }}</h2>{%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}{%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}</div>
</div></div></section>
{% schema %}
{"name":"Occasions image banner","settings":[
 {"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"range","id":"height","label":"Desktop height","min":320,"max":800,"step":20,"unit":"px","default":620},{"type":"range","id":"overlay","label":"Overlay","min":0,"max":60,"step":5,"unit":"%","default":5},
 {"type":"inline_richtext","id":"heading","label":"Heading","default":"What to Send,"},{"type":"text","id":"subheading","label":"Subheading","default":"WHEN IT MATTERS."},{"type":"text","id":"button_label","label":"Button label","default":"SHOP OCCASIONS"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color","id":"background","label":"Section background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},
 {"type":"header","content":"Section layout"},{"type":"select","id":"content_width","label":"Content width","default":"full","options":[{"value":"contained","label":"Container"},{"value":"fluid","label":"Container fluid"},{"value":"full","label":"Full width"},{"value":"custom","label":"Custom width"}]},{"type":"range","id":"custom_width","label":"Custom width","min":600,"max":2000,"step":20,"unit":"px","default":1600},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":0}
],"presets":[{"name":"Occasions image banner"}]}
{% endschema %}
