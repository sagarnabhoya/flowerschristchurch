<section class="db-section full-width" style="background:{{ section.settings.background }}">
  <div class="db-page">
    <div class="db-section-head"><div><p class="db-kicker">{{ section.settings.eyebrow }}</p><h2 class="db-title">{{ section.settings.heading }}</h2></div>{%- if section.settings.copy != blank -%}<div class="db-section-head__aside db-copy">{{ section.settings.copy }}</div>{%- endif -%}</div>
    <div class="db-category-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign category_collection = block.settings.collection
          if category_collection == blank
            assign category_collection = collections.all
          endif
          assign destination = block.settings.link | default: category_collection.url
          assign image = block.settings.image | default: category_collection.image
          if image == blank
            assign image = category_collection.products[forloop.index0].featured_image | default: category_collection.products.first.featured_image
          endif
        -%}
        <a class="db-category-card" href="{{ destination | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if image != blank and image.width != blank -%}{{ image | image_url: width: 1200 | image_tag: widths: '450,700,900,1200', sizes: '(min-width:750px) 33vw, 82vw', loading: 'lazy', alt: block.settings.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
          <div class="db-category-card__content"><h3>{{ block.settings.title | default: category_collection.title }}</h3><span>{{ block.settings.label }}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Shop categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find their favourite" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Something lovely, <em>for every moment.</em>" },
    { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>Fresh flowers, thoughtful hampers and locally made gifts for every kind of day.</p>" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fffaf3" }
  ],
  "blocks": [{ "type": "category", "name": "Category", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "image_picker", "id": "image", "label": "Custom image" },
    { "type": "text", "id": "title", "label": "Custom title" }, { "type": "text", "id": "label", "label": "Link label", "default": "Shop now" }, { "type": "url", "id": "link", "label": "Custom link" }
  ] }],
  "presets": [{ "name": "Shop categories", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
