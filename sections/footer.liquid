<footer class="db-reference-footer full-width" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
 <div class="db-reference-footer__inner">
  <div class="db-reference-footer__grid">
   <div class="db-reference-footer__identity">
    <a class="db-reference-footer__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{%- if settings.logo != blank -%}{{ settings.logo | image_url: width: 500 | image_tag: widths: '200,320,500', sizes: '200px', loading: 'lazy', alt: shop.name }}{%- else -%}{{ shop.name }}{%- endif -%}</a>
    <div class="db-footer-socials">{%- for block in section.blocks -%}{%- if block.type == 'social' -%}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>{%- if block.settings.icon != blank -%}{{ block.settings.icon | image_url: width: 64 | image_tag: width: 24, height: 24, loading: 'lazy', alt: '' }}{%- else -%}{%- assign social_key = block.settings.label | downcase -%}{%- case social_key -%}{%- when 'instagram' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>{%- when 'facebook' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h3l.5-4H14V7c0-1.2.6-2 2.2-2H18V1.4c-.8-.1-1.8-.2-2.8-.2-3.2 0-5.2 2-5.2 5.5V9H7v4h3v8"/></svg>{%- when 'pinterest' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 21c1.5-4.5 2-6.5 2.6-9.2-.6-1.3 0-4 1.8-4 1.4 0 1.9 1 1.9 2.2 0 1.4-.9 3.5-1.3 5.4-.4 1.6.8 2.9 2.4 2.9 2.9 0 4.8-3.7 4.8-8 0-3.3-2.7-7.3-8.3-7.3C7.2 3 3.5 7.5 3.5 12c0 2.1.6 3.6 1.8 4.8"/></svg>{%- else -%}<span>{{ block.settings.label | slice: 0 }}</span>{%- endcase -%}{%- endif -%}</a>{%- endif -%}{%- endfor -%}</div>
   </div>
   <div class="db-reference-footer__about"><div>{{ section.settings.about | newline_to_br }}</div>{%- if section.settings.about_secondary != blank -%}<p>{{ section.settings.about_secondary | newline_to_br }}</p>{%- endif -%}{%- if section.settings.phone != blank -%}<p><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>{%- endif -%}{%- if section.settings.acknowledgement != blank -%}<div class="db-reference-footer__ack">{{ section.settings.acknowledgement | newline_to_br }}</div>{%- endif -%}</div>
   <nav><h2 class="visually-hidden">{{ section.settings.menu_one_heading }}</h2><ul>{%- for link in section.settings.menu_one.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul></nav>
   <nav><h2 class="visually-hidden">{{ section.settings.menu_two_heading }}</h2><ul>{%- for link in section.settings.menu_two.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul></nav>
   <div class="db-reference-footer__signup"><p>{{ section.settings.newsletter_heading }}</p>{%- form 'customer', class: 'db-reference-footer__form' -%}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label><input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="Your email address" required><button type="submit" aria-label="Subscribe">→</button>{%- endform -%}</div>
  </div>
  <div class="db-reference-footer__bottom"><p>© {{ 'now' | date: '%Y' }} {{ shop.name }}</p>{%- if section.settings.show_payment_icons -%}<div class="db-payment-icons">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>{%- endif -%}</div>
 </div>
</footer>
{% schema %}
{
 "name":"Reference footer",
 "settings":[
  {"type":"textarea","id":"about","label":"Brand introduction","default":"We're the local experts in letting every day bloom with beautifully curated bouquets and thoughtful gifts."},{"type":"textarea","id":"about_secondary","label":"Additional brand text","default":"We love a blossoming relationship. Contact our friendly local team if you need help choosing or sending flowers."},{"type":"text","id":"phone","label":"Phone number"},{"type":"textarea","id":"acknowledgement","label":"Acknowledgement text"},
  {"type":"text","id":"menu_one_heading","label":"First menu heading","default":"Customer care"},{"type":"link_list","id":"menu_one","label":"First menu"},{"type":"text","id":"menu_two_heading","label":"Second menu heading","default":"Flower delivery"},{"type":"link_list","id":"menu_two","label":"Second menu"},
  {"type":"text","id":"newsletter_heading","label":"Newsletter heading","default":"Blooms to brighten the daily. Emails to delight your inbox."},{"type":"checkbox","id":"show_payment_icons","label":"Show payment icons","default":true},{"type":"color","id":"background","label":"Background","default":"#fff4f5"},{"type":"color","id":"text_color","label":"Text","default":"#41511d"}
 ],
 "blocks":[{"type":"social","name":"Social link","settings":[{"type":"text","id":"label","label":"Platform","default":"Instagram"},{"type":"url","id":"link","label":"Link"},{"type":"image_picker","id":"icon","label":"Custom icon"}]}],"max_blocks":8
}
{% endschema %}
