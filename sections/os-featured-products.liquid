{% render 'db-section-style', section: section %}
{%- assign featured_collection = section.settings.collection | default: collections.all -%}
<section id="os-product-carousel-{{ section.id }}" class="os-product-spotlight full-width" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
 <div class="db-section-shell db-section-shell--{{ section.settings.content_width | default: 'contained' }}"><os-product-carousel class="os-product-carousel" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" data-initial-index="{{ section.settings.initial_slide | minus: 1 }}">
  <div class="os-product-carousel__track" data-product-carousel-track>
   {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
    {%- assign product_image_loading = 'lazy' -%}{%- if forloop.first -%}{%- assign product_image_loading = 'eager' -%}{%- endif -%}
    <article class="os-product-slide" data-product-carousel-slide>
      <a class="os-product-slide__media" href="{{ product.url }}">{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '400,600,800,1100,1400', sizes: '(min-width: 750px) 28vw, 65vw', loading: product_image_loading, alt: product.featured_image.alt | default: product.title }}{%- if section.settings.badge_label != blank -%}<span class="os-product-slide__badge">{{ section.settings.badge_label }}</span>{%- endif -%}</a>
      <div class="os-product-slide__content"><div><h2>{{ product.title }}</h2>{%- if section.settings.show_description and product.description != blank -%}<div class="os-product-slide__description">{{ product.description | strip_html | truncatewords: 28 }}</div>{%- endif -%}<p class="os-product-slide__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</p><a class="os-product-slide__button" href="{{ product.url }}">{{ section.settings.button_label }}</a></div></div>
    </article>
   {%- else -%}
    <article class="os-product-slide" data-product-carousel-slide><div class="os-product-slide__media">{{ 'product-1' | placeholder_svg_tag }}</div><div class="os-product-slide__content"><div><h2>Featured bouquet</h2><p>Choose a collection in the Theme Editor.</p></div></div></article>
   {%- endfor -%}
  </div>
  {%- if featured_collection.products.size > 1 -%}<button class="os-product-carousel__arrow os-product-carousel__arrow--prev" type="button" data-product-carousel-prev aria-label="Previous product"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button><button class="os-product-carousel__arrow os-product-carousel__arrow--next" type="button" data-product-carousel-next aria-label="Next product"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>{%- endif -%}
 </os-product-carousel></div>
</section>
{% schema %}
{
 "name": "Product spotlight slider",
 "settings": [
  { "type": "collection", "id": "collection", "label": "Collection" }, { "type": "range", "id": "products_to_show", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 },
  { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true }, { "type": "text", "id": "button_label", "label": "Button label", "default": "Order Now" }, { "type": "text", "id": "badge_label", "label": "Image badge", "default": "DB LOVES!" },
  { "type": "range", "id": "initial_slide", "label": "Initial slide", "min": 1, "max": 12, "step": 1, "default": 1 }, { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false }, { "type": "range", "id": "interval", "label": "Autoplay interval", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 },
  { "type": "color", "id": "background", "label": "Section background", "default": "#fffbf6" }, { "type": "color", "id": "text_color", "label": "Text", "default": "#41511d" },
  { "type": "header", "content": "Section layout" }, { "type": "select", "id": "content_width", "label": "Content width", "default": "full", "options": [{ "value": "contained", "label": "Container" }, { "value": "fluid", "label": "Container fluid" }, { "value": "full", "label": "Full width" }, { "value": "custom", "label": "Custom width" }] },
  { "type": "range", "id": "custom_width", "label": "Custom width", "min": 600, "max": 2000, "step": 20, "unit": "px", "default": 1600 }, { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }, { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
 ], "presets": [{ "name": "Product spotlight slider" }]
}
{% endschema %}
