{% render 'os-section-style', section: section %}
{%- assign manual_slides = section.blocks | where: 'type', 'slide' -%}
{%- assign use_manual_slides = false -%}
{%- if section.settings.product_source == 'manual' -%}
  {%- if manual_slides.size > 0 -%}{%- assign use_manual_slides = true -%}{%- endif -%}
{%- endif -%}
<section class="os-product-spotlight{% if section.settings.truncate_slide_title %} os-product-spotlight--truncate-title{% endif %}{% if section.settings.truncate_slide_description %} os-product-spotlight--truncate-description{% endif %} full-width db-section-layout" style="--os-desktop-slides:{{ section.settings.desktop_slides }};--os-mobile-slides:{{ section.settings.mobile_slides }};--os-desktop-gap:{{ section.settings.desktop_gap }}px;--os-mobile-gap:{{ section.settings.mobile_gap }}px;--os-slide-content-gap:{{ section.settings.slide_content_gap }}px;--os-mobile-slide-content-gap:{{ section.settings.mobile_slide_content_gap }}px;--os-heading-size:{{ section.settings.heading_size }}px;--os-heading-mobile-size:{{ section.settings.mobile_heading_size }}px;--os-slide-title-lines:{{ section.settings.slide_title_lines }};--os-slide-description-lines:{{ section.settings.slide_description_lines }};background:{{ section.settings.background }};color:{{ section.settings.text_color }}">
  {% render 'os-section-background', section: section %}
  <div class="db-section-shell db-section-shell--{{ section.settings.content_width }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.copy != blank -%}
      <header class="os-carousel-section-head os-carousel-section-head--{{ section.settings.heading_alignment }} os-carousel-section-head--{{ section.settings.heading_layout }} os-carousel-section-head--{{ section.settings.heading_font }}">
        <div class="os-carousel-section-head__title">{%- if section.settings.eyebrow != blank -%}<p class="db-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}{%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}</div>
        {%- if section.settings.copy != blank -%}<div class="os-carousel-section-head__copy">{{ section.settings.copy }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    <os-product-carousel class="os-product-carousel os-product-carousel--nav-{{ section.settings.navigation_position }}" data-desktop-layout="slider" data-mobile-layout="slider" data-desktop-centered="{{ section.settings.desktop_centered }}" data-mobile-centered="{{ section.settings.mobile_centered }}" data-desktop-navigation="{{ section.settings.desktop_navigation }}" data-mobile-navigation="{{ section.settings.mobile_navigation }}" data-desktop-progress="{{ section.settings.desktop_progress }}" data-mobile-progress="{{ section.settings.mobile_progress }}" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" data-initial-index="0">
      <div id="os-product-carousel-track-{{ section.id }}" class="os-product-carousel__track" data-product-carousel-track>
        {%- if use_manual_slides -%}
          {%- for block in manual_slides -%}
            {%- assign selected_product = block.settings.product -%}
            {%- assign selected_collection = block.settings.collection -%}
            {%- assign collection_product_image = selected_collection.products.first.featured_image -%}
            {%- assign slide_image = block.settings.image | default: selected_product.featured_image | default: selected_collection.image | default: collection_product_image -%}
            {%- assign slide_title = block.settings.title | default: selected_product.title | default: selected_collection.title | default: 'Featured bouquet' -%}
            {%- assign slide_description = block.settings.description | default: selected_product.description | default: selected_collection.description | strip_html -%}
            {%- assign slide_url = block.settings.link | default: selected_product.url | default: selected_collection.url | default: routes.all_products_collection_url -%}
            {%- assign slide_button = block.settings.button_label | default: section.settings.button_label -%}
            <article class="os-product-slide" data-product-carousel-slide {{ block.shopify_attributes }}>
              <a class="os-product-slide__media" href="{{ slide_url }}">{%- if slide_image != blank -%}{{ slide_image | image_url: width: 1400 | image_tag: widths: '400,600,800,1100,1400', sizes: '(min-width:750px) 28vw,65vw', loading: 'lazy', alt: slide_image.alt | default: slide_title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</a>
              <div class="os-product-slide__content"><div>{%- if section.settings.show_title -%}<h2>{{ slide_title }}</h2>{%- endif -%}{%- if section.settings.show_description and slide_description != blank -%}<div class="os-product-slide__description">{{ slide_description }}</div>{%- endif -%}{%- if section.settings.show_price -%}{%- if block.settings.price != blank -%}<p class="os-product-slide__price">{{ block.settings.price }}</p>{%- elsif selected_product != blank -%}<p class="os-product-slide__price">{% if selected_product.price_varies %}From {% endif %}{{ selected_product.price | money }}</p>{%- endif -%}{%- endif -%}{%- if slide_button != blank -%}<a class="os-product-slide__button" href="{{ slide_url }}">{{ slide_button }}</a>{%- endif -%}</div></div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- assign featured_collection = section.settings.collection | default: collections.all -%}
          {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
            {%- assign product_image_loading = 'lazy' -%}{%- if forloop.first -%}{%- assign product_image_loading = 'eager' -%}{%- endif -%}
            <article class="os-product-slide" data-product-carousel-slide>
              <a class="os-product-slide__media" href="{{ product.url }}">{%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 1400 | image_tag: widths: '400,600,800,1100,1400', sizes: '(min-width:750px) 28vw,65vw', loading: product_image_loading, alt: product.featured_image.alt | default: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}</a>
              <div class="os-product-slide__content"><div>{%- if section.settings.show_title -%}<h2>{{ product.title }}</h2>{%- endif -%}{%- if section.settings.show_description and product.description != blank -%}<div class="os-product-slide__description">{{ product.description | strip_html }}</div>{%- endif -%}{%- if section.settings.show_price -%}<p class="os-product-slide__price">{% if product.price_varies %}From {% endif %}{{ product.price | money }}</p>{%- endif -%}{%- if section.settings.button_label != blank -%}<a class="os-product-slide__button" href="{{ product.url }}">{{ section.settings.button_label }}</a>{%- endif -%}</div></div>
            </article>
          {%- else -%}
            <article class="os-product-slide" data-product-carousel-slide><div class="os-product-slide__media">{{ 'product-1' | placeholder_svg_tag }}</div><div class="os-product-slide__content"><div><h2>Featured bouquet</h2><p>Choose a collection or add manual product slides in the Theme Editor.</p></div></div></article>
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button class="os-product-carousel__arrow os-product-carousel__arrow--prev" type="button" data-product-carousel-prev aria-controls="os-product-carousel-track-{{ section.id }}" aria-label="Previous product"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
      <button class="os-product-carousel__arrow os-product-carousel__arrow--next" type="button" data-product-carousel-next aria-controls="os-product-carousel-track-{{ section.id }}" aria-label="Next product"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
      <div class="os-product-carousel__progress" data-product-carousel-progress aria-hidden="true"><span></span></div>
    </os-product-carousel>
  </div>
</section>
{% schema %}
{
  "name": "Product spotlight",
  "settings": [
    {"type":"header","content":"Section heading"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fresh from the studio"},
    {"type":"inline_richtext","id":"heading","label":"Heading","default":"Featured flowers"},
    {"type":"richtext","id":"copy","label":"Supporting text"},
    {"type":"range","id":"heading_size","label":"Desktop heading size","min":28,"max":96,"step":2,"unit":"px","default":56},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":24,"max":64,"step":2,"unit":"px","default":36},
    {"type":"select","id":"heading_font","label":"Heading style","default":"display","options":[{"value":"display","label":"Display"},{"value":"body","label":"Sans serif"}]},
    {"type":"select","id":"heading_alignment","label":"Heading alignment","default":"left","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},
    {"type":"select","id":"heading_layout","label":"Heading layout","default":"split","options":[{"value":"split","label":"Title and text side by side"},{"value":"stacked","label":"Title above text"}]},
    {"type":"header","content":"Products"},
    {"type":"select","id":"product_source","label":"Product source","default":"collection","options":[{"value":"collection","label":"Collection"},{"value":"manual","label":"Manual slides (products or collections)"}]},
    {"type":"collection","id":"collection","label":"Collection","info":"Used when Product source is Collection."},
    {"type":"range","id":"products_to_show","label":"Products to show","min":2,"max":12,"step":1,"default":8,"visible_if":"{{ section.settings.product_source == 'collection' }}"},
    {"type":"header","content":"Slide text truncation"},
    {"type":"checkbox","id":"truncate_slide_title","label":"Truncate slide title","default":false},
    {"type":"range","id":"slide_title_lines","label":"Slide title lines","min":1,"max":4,"step":1,"default":2,"visible_if":"{{ section.settings.truncate_slide_title == true }}"},
    {"type":"checkbox","id":"truncate_slide_description","label":"Truncate slide description","default":true},
    {"type":"range","id":"slide_description_lines","label":"Slide description lines","min":1,"max":8,"step":1,"default":3,"visible_if":"{{ section.settings.truncate_slide_description == true }}"},
    {"type":"checkbox","id":"show_title","label":"Show title","default":true},{"type":"checkbox","id":"show_description","label":"Show description","default":true},{"type":"checkbox","id":"show_price","label":"Show price","default":true},{"type":"text","id":"button_label","label":"Default button label","default":"Order Now"},
    {"type":"header","content":"Desktop slider"},{"type":"range","id":"desktop_slides","label":"Slides per view","min":1,"max":5,"step":0.1,"default":1.2},{"type":"range","id":"desktop_gap","label":"Space between slides","min":0,"max":80,"step":4,"unit":"px","default":0},{"type":"checkbox","id":"desktop_centered","label":"Center active slide","default":true},
    {"type":"header","content":"Mobile slider"},{"type":"range","id":"mobile_slides","label":"Slides per view","min":1,"max":3,"step":0.1,"default":1.1},{"type":"range","id":"mobile_gap","label":"Space between slides","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"checkbox","id":"mobile_centered","label":"Center active slide","default":true},
    {"type":"header","content":"Carousel controls"},{"type":"select","id":"navigation_position","label":"Navigation position","default":"active","options":[{"value":"active","label":"Beside centered slide"},{"value":"edges","label":"Section edges"}]},{"type":"checkbox","id":"desktop_navigation","label":"Show navigation on desktop","default":true},{"type":"checkbox","id":"mobile_navigation","label":"Show navigation on mobile","default":false},{"type":"checkbox","id":"desktop_progress","label":"Show progress on desktop","default":false},{"type":"checkbox","id":"mobile_progress","label":"Show progress on mobile","default":true},{"type":"checkbox","id":"autoplay","label":"Autoplay","default":false},{"type":"range","id":"interval","label":"Autoplay interval","min":3,"max":10,"step":1,"unit":"s","default":6},
    {"type":"header","content":"Spotlight spacing"},{"type":"range","id":"slide_content_gap","label":"Desktop space between image and content","min":0,"max":160,"step":4,"unit":"px","default":60},{"type":"range","id":"mobile_slide_content_gap","label":"Mobile space between image and content","min":0,"max":80,"step":2,"unit":"px","default":16},
    {"type":"header","content":"Section style"},{"type":"color","id":"background","label":"Section background","default":"#fffbf6"},{"type":"color","id":"text_color","label":"Text","default":"#41511d"},{"type":"select","id":"content_width","label":"Content width","default":"full","options":[{"value":"contained","label":"Container"},{"value":"fluid","label":"Container fluid"},{"value":"full","label":"Full width"},{"value":"custom","label":"Custom width"}]},{"type":"range","id":"custom_width","label":"Custom width","min":600,"max":2000,"step":20,"unit":"px","default":1600},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":40},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":40},{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"image_picker","id":"mobile_background_image","label":"Mobile background image"},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":40},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":40},{"type":"range","id":"margin_top","label":"Desktop top margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_top","label":"Mobile top margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0}
  ],
  "blocks":[{"type":"slide","name":"Product / collection","settings":[{"type":"header","content":"Content source"},{"type":"product","id":"product","label":"Product","info":"Used first when both a product and collection are selected."},{"type":"collection","id":"collection","label":"Collection","info":"Uses the collection title, description, image, and URL. The first product image is used if the collection has no image."},{"type":"header","content":"Overrides"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"text","id":"title","label":"Title override"},{"type":"textarea","id":"description","label":"Description override"},{"type":"text","id":"price","label":"Price override"},{"type":"text","id":"button_label","label":"Button label override"},{"type":"url","id":"link","label":"Link override"}]}],
  "presets":[{"name":"Product spotlight"}]
}
{% endschema %}
