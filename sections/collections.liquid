<section class="full-width"><header class="db-page-hero"><div class="db-page"><p class="db-kicker">Discover something lovely</p><h1 class="db-title">Shop all <em>collections.</em></h1></div></header><div class="db-page db-section"><div class="db-category-grid">{%- for collection in collections -%}<a class="db-category-card" href="{{ collection.url }}">{%- if collection.featured_image -%}{{ collection.featured_image | image_url: width: 1000 | image_tag: widths: '450,700,1000', loading: 'lazy', alt: collection.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}<div class="db-category-card__content"><h2>{{ collection.title }}</h2><span>Explore collection</span></div></a>{%- endfor -%}</div></div></section>
{% schema %}{ "name": "Editorial collections", "settings": [], "presets": [{ "name": "Editorial collections" }] }{% endschema %}
