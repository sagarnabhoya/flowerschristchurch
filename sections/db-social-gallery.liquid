{% render 'db-section-style', section: section %}
<section class="db-social full-width" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><div class="db-section-shell db-section-shell--{{ section.settings.content_width | default: 'contained' }}">
 <h2>{{ section.settings.heading }}</h2>
 <div class="db-social__viewport" data-carousel><div class="db-social__track" data-carousel-track>
  {%- for block in section.blocks -%}{%- assign fallback_social_image = collections.all.products[forloop.index0].featured_image | default: collections.all.products.first.featured_image -%}<button class="db-social-card" type="button" data-social-open="social-{{ section.id }}-{{ block.id }}" data-carousel-slide {{ block.shopify_attributes }} aria-label="Open post by {{ block.settings.account | escape }}">
   {%- if block.settings.video != blank -%}{{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '700x' }}<span class="db-social-card__play">▶</span>{%- elsif block.settings.image != blank -%}{{ block.settings.image | image_url: width: 900 | image_tag: widths: '300,500,700,900', sizes: '260px', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.caption }}{%- elsif fallback_social_image != blank -%}{{ fallback_social_image | image_url: width: 900 | image_tag: widths: '300,500,700,900', sizes: '260px', loading: 'lazy', alt: block.settings.caption }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
  </button>{%- endfor -%}
 </div><button class="db-carousel-arrow db-carousel-arrow--prev" type="button" data-carousel-prev aria-label="Previous post">&#8249;</button><button class="db-carousel-arrow db-carousel-arrow--next" type="button" data-carousel-next aria-label="Next post">&#8250;</button></div>
 {%- for block in section.blocks -%}{%- assign fallback_modal_image = collections.all.products[forloop.index0].featured_image | default: collections.all.products.first.featured_image -%}<dialog class="db-social-modal" id="social-{{ section.id }}-{{ block.id }}"><button type="button" class="db-social-modal__close" data-dialog-close aria-label="Close">×</button><div class="db-social-modal__media">{%- if block.settings.video != blank -%}{{ block.settings.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1000x' }}{%- elsif block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1400 | image_tag: widths: '600,900,1200,1400', sizes: '(min-width:750px) 50vw, 100vw', loading: 'lazy', alt: block.settings.image.alt | default: block.settings.caption }}{%- elsif fallback_modal_image != blank -%}{{ fallback_modal_image | image_url: width: 1400 | image_tag: widths: '600,900,1200,1400', sizes: '(min-width:750px) 50vw, 100vw', loading: 'lazy', alt: block.settings.caption }}{%- endif -%}</div><div class="db-social-modal__copy"><header>{%- if block.settings.avatar != blank -%}{{ block.settings.avatar | image_url: width: 96 | image_tag: width: 48, height: 48, loading: 'lazy', alt: '' }}{%- endif -%}<strong>{{ block.settings.account }}</strong></header><div>{{ block.settings.caption | newline_to_br }}</div><p>{{ block.settings.date }}</p></div></dialog>{%- endfor -%}
</div></section>
{% schema %}
{"name":"Social gallery","settings":[
 {"type":"inline_richtext","id":"heading","label":"Heading","default":"A daily dose of fresh blooms, gifting inspiration and everyday joy @flowersacrosschristchurch"},{"type":"color","id":"background","label":"Section background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Text","default":"#41511d"},
 {"type":"header","content":"Section layout"},{"type":"select","id":"content_width","label":"Content width","default":"full","options":[{"value":"contained","label":"Container"},{"value":"fluid","label":"Container fluid"},{"value":"full","label":"Full width"},{"value":"custom","label":"Custom width"}]},{"type":"range","id":"custom_width","label":"Custom width","min":600,"max":2000,"step":20,"unit":"px","default":1600},{"type":"range","id":"padding_top","label":"Top padding","min":0,"max":160,"step":4,"unit":"px","default":32},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":0,"max":160,"step":4,"unit":"px","default":48}
],"blocks":[{"type":"post","name":"Social post","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"video","id":"video","label":"Shopify-hosted video"},{"type":"image_picker","id":"avatar","label":"Account avatar"},{"type":"text","id":"account","label":"Account name","default":"flowersacrosschristchurch"},{"type":"textarea","id":"caption","label":"Caption","default":"Fresh flowers and thoughtful gifting."},{"type":"text","id":"date","label":"Date"}]}],"presets":[{"name":"Social gallery","blocks":[{"type":"post"},{"type":"post"},{"type":"post"},{"type":"post"},{"type":"post"}]}]}
{% endschema %}
