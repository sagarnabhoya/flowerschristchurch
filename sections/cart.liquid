{% comment %}Cart layout blocks render in the merchant's chosen order.{% endcomment %}
{%- liquid
  assign offset_variant = section.settings.offset_product.selected_or_first_available_variant
  assign extra_collection = section.settings.extra_collection | default: collections['plants-others']
  assign card_collection = section.settings.card_collection | default: collections['greeting-cards']
  assign available_cards = card_collection.products | where: 'available', true
-%}
<section class="os-cart-section full-width" style="--os-cart-bg:{{ section.settings.background }};--os-cart-text:{{ section.settings.text_color }};--os-cart-accent:{{ section.settings.accent_color }};--os-cart-width:{{ section.settings.content_width }}px;--os-cart-radius:{{ section.settings.corner_radius }}px;--os-cart-pad-top:{{ section.settings.padding_top }}px;--os-cart-pad-bottom:{{ section.settings.padding_bottom }}px">
<os-cart-page class="os-cart" data-money-format="{{ shop.money_format | escape }}"><div class="os-cart__inner">
{%- if cart.item_count == 0 -%}
<header class="os-cart__header{% if cart.item_count == 0 %} os-cart__header--empty{% endif %}">{%- if section.settings.eyebrow != blank -%}<p class="db-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}<h1>{{ section.settings.heading }}</h1>{%- if cart.item_count > 0 -%}<span>{{ section.settings.quantity_heading }}</span><span>{{ section.settings.total_heading }}</span>{%- endif -%}</header>
<div class="os-cart-empty"><p>{{ section.settings.empty_text }}</p><a class="db-button" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">{{ section.settings.empty_button }}</a></div>
{%- else -%}
<form action="{{ routes.cart_url }}" method="post" data-cart-form>
{%- assign layout_blocks = section.blocks | reject: 'type', 'step' -%}
{%- if layout_blocks.size > 0 -%}
{%- for block in layout_blocks -%}
<div class="os-cart-block os-cart-block--{{ block.type }}" {{ block.shopify_attributes }}>
{%- case block.type -%}
{%- when 'progress' -%}
{%- if section.settings.show_steps -%}
<ol class="os-cart-steps" aria-label="Checkout progress">
{%- for i in (1..4) -%}{%- assign key = 'label_' | append: i -%}
<li><span>{{ i }}</span><strong>{{ block.settings[key] }}</strong>{% if i == 2 %}<small>{{ block.settings.optional }}</small>{% endif %}</li>
{%- endfor -%}</ol>{%- endif -%}
{%- when 'cart_body' -%}
<header class="os-cart__header{% if cart.item_count == 0 %} os-cart__header--empty{% endif %}">{%- if section.settings.eyebrow != blank -%}<p class="db-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}<h1>{{ section.settings.heading }}</h1>{%- if cart.item_count > 0 -%}<span>{{ section.settings.quantity_heading }}</span><span>{{ section.settings.total_heading }}</span>{%- endif -%}</header>
<div class="os-cart__delivery">{%- for item in cart.items -%}<article class="os-cart-item{% if item.parent_relationship != blank %} os-cart-item--extra{% endif %}" data-cart-line="{{ forloop.index }}"><a class="os-cart-item__media" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 420 | image_tag: widths: '140,220,320,420', loading: 'eager', alt: item.image.alt | default: item.product.title }}{%- endif -%}</a><div class="os-cart-item__body"><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{%- unless item.product.has_only_default_variant -%}<p class="os-cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}{%- if section.settings.show_item_properties -%}<dl class="os-cart-item__properties">{%- for property in item.properties -%}{%- assign first_character = property.first | slice: 0 -%}{%- if property.last != blank and first_character != '_' -%}<div><dt>{{ property.first }}</dt><dd>{%- if property.last contains '/uploads/' -%}<a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>{%- else -%}{{ property.last }}{%- endif -%}</dd></div>{%- endif -%}{%- endfor -%}</dl>{%- endif -%}<div class="os-cart-item__actions"><div class="os-cart-quantity"><button type="button" data-cart-quantity="-1" aria-label="Decrease quantity">−</button><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ item.product.title | escape }} quantity"><button type="button" data-cart-quantity="1" aria-label="Increase quantity">+</button></div><button class="os-cart-remove" type="button" data-cart-remove>{{ section.settings.remove_label }}</button></div></div><strong class="os-cart-item__price">{{ item.final_line_price | money }}</strong></article>{%- endfor -%}</div>
<div class="os-cart-summary"><div><span>{{ section.settings.subtotal_label }}</span><strong>{{ cart.total_price | money }}</strong></div>{%- if section.settings.show_shipping -%}<div><span>{{ section.settings.shipping_label }}</span><strong>{{ section.settings.shipping_value }}</strong></div>{%- endif -%}</div>
{%- when 'offset' -%}
{%- if section.settings.show_offset and offset_variant != blank -%}{%- assign offset_in_cart = false -%}{%- for item in cart.items -%}{%- if item.variant_id == offset_variant.id -%}{%- assign offset_in_cart = true -%}{%- endif -%}{%- endfor -%}<div class="os-cart-offset"><div><h2>{{ section.settings.offset_heading }}</h2><p>{{ section.settings.offset_text }}</p></div><label><input type="checkbox" data-cart-addon="{{ offset_variant.id }}"{% if offset_in_cart %} checked{% endif %}{% unless offset_variant.available or offset_in_cart %} disabled{% endunless %}><span aria-hidden="true"></span></label></div>{%- endif -%}
{%- when 'extras' -%}
{%- assign slider_heading = block.settings.heading | default: section.settings.extras_heading -%}
{%- assign slider_collection = block.settings.collection | default: extra_collection -%}
{%- if section.settings.show_extras and slider_collection != blank and slider_collection.products_count > 0 -%}{%- render 'os-cart-addon-carousel', collection: slider_collection, heading: slider_heading, subheading: section.settings.extras_subheading, limit: section.settings.extras_limit, card_radius: section.settings.addon_radius -%}{%- endif -%}
{%- when 'cards' -%}
{%- assign slider_heading = block.settings.heading | default: section.settings.cards_heading -%}
{%- assign slider_collection = block.settings.collection | default: card_collection -%}
{%- assign available_cards = slider_collection.products | where: 'available', true -%}
{%- if section.settings.show_cards and available_cards.size > 0 -%}{%- render 'os-cart-addon-carousel', collection: slider_collection, products: available_cards, heading: slider_heading, subheading: section.settings.cards_subheading, limit: section.settings.cards_limit, card_radius: section.settings.addon_radius -%}{%- endif -%}
{%- when 'recipient' -%}
{%- if section.settings.show_recipient_contact -%}<section class="os-cart-recipient"><div><p class="db-kicker">Delivery contact</p><h2>{{ section.settings.recipient_heading }}</h2><p>{{ section.settings.recipient_intro }}</p></div><div class="os-cart-recipient__fields"><label>{{ section.settings.recipient_name_label }}<input type="text" name="attributes[Recipient name]" value="{{ cart.attributes['Recipient name'] | escape }}" autocomplete="name" required></label><label>{{ section.settings.recipient_phone_label }}<input type="tel" name="attributes[Recipient phone]" value="{{ cart.attributes['Recipient phone'] | escape }}" autocomplete="tel" required></label><label>{{ section.settings.recipient_email_label }}<input type="email" name="attributes[Recipient email]" value="{{ cart.attributes['Recipient email'] | escape }}" autocomplete="email"></label></div></section>{%- endif -%}
{%- when 'message' -%}
{%- if section.settings.show_message -%}<section class="os-cart-message"><button class="os-cart-message__helper" type="button" data-message-helper aria-expanded="false" aria-controls="MessageCreator-{{ section.id }}"><span>{{ section.settings.helper_label | split: "?" | first }}?</span><small>{{ section.settings.helper_subheading }}</small></button>{%- render 'os-message-creator', message_limit: section.settings.message_limit -%}<div class="os-cart-message__fields"><label class="os-cart-message__message">{{ section.settings.message_label }}<textarea name="attributes[Message]" rows="5" maxlength="{{ section.settings.message_limit }}" data-message-input>{{ cart.attributes.Message }}</textarea><span class="os-cart-message__count"><b data-message-count>0</b>/{{ section.settings.message_limit }}</span></label>{%- if section.settings.show_emojis -%}<div class="os-cart-message__emoji">{%- assign emojis = section.settings.emojis | split: ' ' -%}{%- for emoji in emojis -%}<button type="button" data-message-emoji="{{ emoji | escape }}">{{ emoji }}</button>{%- endfor -%}</div>{%- endif -%}</div>{%- if section.settings.show_preview -%}<div class="os-cart-message__preview"><span>{{ section.settings.preview_heading }}</span><p data-message-preview data-empty="{{ section.settings.preview_placeholder | escape }}">{{ cart.attributes.Message | default: section.settings.preview_placeholder }}</p><small>{{ section.settings.preview_note }}</small></div>{%- endif -%}</section>{%- endif -%}
{%- when 'note' -%}
{%- if section.settings.show_note -%}<details class="os-cart-note"><summary>{{ section.settings.note_heading }} <span>+</span></summary><textarea name="note" rows="5" placeholder="{{ section.settings.note_placeholder | escape }}">{{ cart.note }}</textarea></details>{%- endif -%}
{%- when 'checkout' -%}
<div class="os-cart-checkout"><p>{{ section.settings.checkout_note }}</p><button class="db-button" type="submit" name="checkout">{{ section.settings.checkout_label }}</button></div>
{%- endcase -%}
</div>
{%- endfor -%}
{%- else -%}
{%- if section.settings.show_steps and cart.item_count > 0 -%}<ol class="os-cart-steps" aria-label="Checkout progress">{%- for block in section.blocks -%}{%- if block.type == 'step' -%}<li {{ block.shopify_attributes }}><span>{{ forloop.index }}</span><strong>{{ block.settings.label }}</strong>{%- if block.settings.optional != blank -%}<small>{{ block.settings.optional }}</small>{%- endif -%}</li>{%- endif -%}{%- endfor -%}</ol>{%- endif -%}
<header class="os-cart__header{% if cart.item_count == 0 %} os-cart__header--empty{% endif %}">{%- if section.settings.eyebrow != blank -%}<p class="db-kicker">{{ section.settings.eyebrow }}</p>{%- endif -%}<h1>{{ section.settings.heading }}</h1>{%- if cart.item_count > 0 -%}<span>{{ section.settings.quantity_heading }}</span><span>{{ section.settings.total_heading }}</span>{%- endif -%}</header>
<div class="os-cart__delivery">{%- for item in cart.items -%}<article class="os-cart-item{% if item.parent_relationship != blank %} os-cart-item--extra{% endif %}" data-cart-line="{{ forloop.index }}"><a class="os-cart-item__media" href="{{ item.url }}">{%- if item.image -%}{{ item.image | image_url: width: 420 | image_tag: widths: '140,220,320,420', loading: 'eager', alt: item.image.alt | default: item.product.title }}{%- endif -%}</a><div class="os-cart-item__body"><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{%- unless item.product.has_only_default_variant -%}<p class="os-cart-item__variant">{{ item.variant.title }}</p>{%- endunless -%}{%- if section.settings.show_item_properties -%}<dl class="os-cart-item__properties">{%- for property in item.properties -%}{%- assign first_character = property.first | slice: 0 -%}{%- if property.last != blank and first_character != '_' -%}<div><dt>{{ property.first }}</dt><dd>{%- if property.last contains '/uploads/' -%}<a href="{{ property.last }}">{{ property.last | split: '/' | last }}</a>{%- else -%}{{ property.last }}{%- endif -%}</dd></div>{%- endif -%}{%- endfor -%}</dl>{%- endif -%}<div class="os-cart-item__actions"><div class="os-cart-quantity"><button type="button" data-cart-quantity="-1" aria-label="Decrease quantity">−</button><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ item.product.title | escape }} quantity"><button type="button" data-cart-quantity="1" aria-label="Increase quantity">+</button></div><button class="os-cart-remove" type="button" data-cart-remove>{{ section.settings.remove_label }}</button></div></div><strong class="os-cart-item__price">{{ item.final_line_price | money }}</strong></article>{%- endfor -%}</div>
<div class="os-cart-summary"><div><span>{{ section.settings.subtotal_label }}</span><strong>{{ cart.total_price | money }}</strong></div>{%- if section.settings.show_shipping -%}<div><span>{{ section.settings.shipping_label }}</span><strong>{{ section.settings.shipping_value }}</strong></div>{%- endif -%}</div>
{%- if section.settings.show_offset and offset_variant != blank -%}{%- assign offset_in_cart = false -%}{%- for item in cart.items -%}{%- if item.variant_id == offset_variant.id -%}{%- assign offset_in_cart = true -%}{%- endif -%}{%- endfor -%}<div class="os-cart-offset"><div><h2>{{ section.settings.offset_heading }}</h2><p>{{ section.settings.offset_text }}</p></div><label><input type="checkbox" data-cart-addon="{{ offset_variant.id }}"{% if offset_in_cart %} checked{% endif %}{% unless offset_variant.available or offset_in_cart %} disabled{% endunless %}><span aria-hidden="true"></span></label></div>{%- endif -%}
{%- if section.settings.show_extras and extra_collection != blank and extra_collection.products_count > 0 -%}{%- render 'os-cart-addon-carousel', collection: extra_collection, heading: section.settings.extras_heading, subheading: section.settings.extras_subheading, limit: section.settings.extras_limit, card_radius: section.settings.addon_radius -%}{%- endif -%}
{%- if section.settings.show_cards and available_cards.size > 0 -%}{%- render 'os-cart-addon-carousel', collection: card_collection, products: available_cards, heading: section.settings.cards_heading, subheading: section.settings.cards_subheading, limit: section.settings.cards_limit, card_radius: section.settings.addon_radius -%}{%- endif -%}
{%- if section.settings.show_recipient_contact -%}<section class="os-cart-recipient"><div><p class="db-kicker">Delivery contact</p><h2>{{ section.settings.recipient_heading }}</h2><p>{{ section.settings.recipient_intro }}</p></div><div class="os-cart-recipient__fields"><label>{{ section.settings.recipient_name_label }}<input type="text" name="attributes[Recipient name]" value="{{ cart.attributes['Recipient name'] | escape }}" autocomplete="name" required></label><label>{{ section.settings.recipient_phone_label }}<input type="tel" name="attributes[Recipient phone]" value="{{ cart.attributes['Recipient phone'] | escape }}" autocomplete="tel" required></label><label>{{ section.settings.recipient_email_label }}<input type="email" name="attributes[Recipient email]" value="{{ cart.attributes['Recipient email'] | escape }}" autocomplete="email"></label></div></section>{%- endif -%}
{%- if section.settings.show_message -%}<section class="os-cart-message"><button class="os-cart-message__helper" type="button" data-message-helper aria-expanded="false" aria-controls="MessageCreator-{{ section.id }}"><span>{{ section.settings.helper_label | split: "?" | first }}?</span><small>{{ section.settings.helper_subheading }}</small></button>{%- render 'os-message-creator', message_limit: section.settings.message_limit -%}<div class="os-cart-message__fields"><label class="os-cart-message__message">{{ section.settings.message_label }}<textarea name="attributes[Message]" rows="5" maxlength="{{ section.settings.message_limit }}" data-message-input>{{ cart.attributes.Message }}</textarea><span class="os-cart-message__count"><b data-message-count>0</b>/{{ section.settings.message_limit }}</span></label>{%- if section.settings.show_emojis -%}<div class="os-cart-message__emoji">{%- assign emojis = section.settings.emojis | split: ' ' -%}{%- for emoji in emojis -%}<button type="button" data-message-emoji="{{ emoji | escape }}">{{ emoji }}</button>{%- endfor -%}</div>{%- endif -%}</div>{%- if section.settings.show_preview -%}<div class="os-cart-message__preview"><span>{{ section.settings.preview_heading }}</span><p data-message-preview data-empty="{{ section.settings.preview_placeholder | escape }}">{{ cart.attributes.Message | default: section.settings.preview_placeholder }}</p><small>{{ section.settings.preview_note }}</small></div>{%- endif -%}</section>{%- endif -%}
{%- if section.settings.show_note -%}<details class="os-cart-note"><summary>{{ section.settings.note_heading }} <span>+</span></summary><textarea name="note" rows="5" placeholder="{{ section.settings.note_placeholder | escape }}">{{ cart.note }}</textarea></details>{%- endif -%}
<div class="os-cart-checkout"><p>{{ section.settings.checkout_note }}</p><button class="db-button" type="submit" name="checkout">{{ section.settings.checkout_label }}</button></div>
{%- endif -%}
<p class="os-cart-status" role="status" aria-live="polite" data-cart-status></p>
</form>{%- endif -%}</div></os-cart-page></section>
{% schema %}
{
  "name": "Reference cart",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1440
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Field corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#fffaf3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#34460d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#92203c"
    },
    {
      "type": "header",
      "content": "Header and steps"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Delivery"
    },
    {
      "type": "text",
      "id": "quantity_heading",
      "label": "Quantity heading",
      "default": "Quantity"
    },
    {
      "type": "text",
      "id": "total_heading",
      "label": "Total heading",
      "default": "Total"
    },
    {
      "type": "checkbox",
      "id": "show_steps",
      "label": "Show checkout steps",
      "default": true
    },
    {
      "type": "header",
      "content": "Cart details"
    },
    {
      "type": "checkbox",
      "id": "show_item_properties",
      "label": "Show delivery and item properties",
      "default": true
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove label",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "subtotal_label",
      "label": "Subtotal label",
      "default": "Subtotal"
    },
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Show shipping row",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Shipping label",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "shipping_value",
      "label": "Shipping value",
      "default": "Calculated at checkout",
      "info": "Actual rates are calculated by Shopify at checkout."
    },
    {
      "type": "header",
      "content": "Carbon offset"
    },
    {
      "type": "checkbox",
      "id": "show_offset",
      "label": "Show carbon offset",
      "default": false
    },
    {
      "type": "product",
      "id": "offset_product",
      "label": "Carbon offset product"
    },
    {
      "type": "text",
      "id": "offset_heading",
      "label": "Heading",
      "default": "Carbon Offset"
    },
    {
      "type": "textarea",
      "id": "offset_text",
      "label": "Description",
      "default": "Offset the carbon footprint of this delivery for a small contribution."
    },
    {
      "type": "header",
      "content": "Extra gifts slider"
    },
    {
      "type": "checkbox",
      "id": "show_extras",
      "label": "Show extra gifts",
      "default": true
    },
    {
      "type": "collection",
      "id": "extra_collection",
      "label": "Extra gifts collection"
    },
    {
      "type": "text",
      "id": "extras_heading",
      "label": "Heading",
      "default": "Add An Extra Gift"
    },
    {
      "type": "text",
      "id": "extras_subheading",
      "label": "Subheading"
    },
    {
      "type": "range",
      "id": "extras_limit",
      "label": "Products",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Greeting cards slider"
    },
    {
      "type": "checkbox",
      "id": "show_cards",
      "label": "Show greeting cards",
      "default": true
    },
    {
      "type": "collection",
      "id": "card_collection",
      "label": "Greeting card collection"
    },
    {
      "type": "text",
      "id": "cards_heading",
      "label": "Heading",
      "default": "Upgrade Your Greeting Card"
    },
    {
      "type": "text",
      "id": "cards_subheading",
      "label": "Subheading",
      "default": "Choose a design that suits the occasion"
    },
    {
      "type": "range",
      "id": "cards_limit",
      "label": "Products",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "addon_radius",
      "label": "Add-on image radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Gift message"
    },
    {
      "type": "checkbox",
      "id": "show_message",
      "label": "Show gift message",
      "default": true
    },
    {
      "type": "text",
      "id": "helper_label",
      "label": "Message helper label",
      "default": "Need Help Writing A Message?"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Message:"
    },
    {
      "type": "range",
      "id": "message_limit",
      "label": "Message character limit",
      "min": 80,
      "max": 300,
      "step": 10,
      "default": 130
    },
    {
      "type": "checkbox",
      "id": "show_emojis",
      "label": "Show symbol buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "emojis",
      "label": "Symbols separated by spaces",
      "default": "♥ ★ ♪ ☺"
    },
    {
      "type": "checkbox",
      "id": "show_preview",
      "label": "Show message preview",
      "default": true
    },
    {
      "type": "text",
      "id": "preview_heading",
      "label": "Preview heading",
      "default": "Your message"
    },
    {
      "type": "text",
      "id": "preview_placeholder",
      "label": "Empty preview text",
      "default": "Your thoughtful words will appear here."
    },
    {
      "type": "text",
      "id": "preview_note",
      "label": "Preview note",
      "default": "Be sure to check for typos!"
    },
    {
      "type": "header",
      "content": "Recipient contact"
    },
    {
      "type": "checkbox",
      "id": "show_recipient_contact",
      "label": "Collect recipient contact information",
      "default": true
    },
    {
      "type": "text",
      "id": "recipient_heading",
      "label": "Heading",
      "default": "Who are we delivering to?"
    },
    {
      "type": "textarea",
      "id": "recipient_intro",
      "label": "Help text",
      "default": "We use these details only when needed to complete the delivery."
    },
    {
      "type": "text",
      "id": "recipient_name_label",
      "label": "Name label",
      "default": "Recipient name"
    },
    {
      "type": "text",
      "id": "recipient_phone_label",
      "label": "Phone label",
      "default": "Recipient phone"
    },
    {
      "type": "text",
      "id": "recipient_email_label",
      "label": "Email label",
      "default": "Recipient email (optional)"
    },
