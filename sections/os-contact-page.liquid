{% render 'os-section-style', section: section %}
<section class="os-contact full-width db-section-layout" style="--os-contact-bg:{{ section.settings.background }};--os-contact-text:{{ section.settings.text_color }};--os-contact-width:{{ section.settings.custom_width }}px">
  {% render 'os-section-background', section: section %}
  <div class="db-page os-contact__inner">
    <header class="os-contact__intro"><p class="db-kicker">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.heading | default: page.title }}</h1><div class="db-rte">{{ section.settings.intro }}</div></header>
    <div class="os-contact__grid">
      <aside class="os-contact__details">
        <h2>{{ section.settings.details_heading }}</h2>
        <address><strong>{{ section.settings.business_name }}</strong><br>{{ section.settings.address | newline_to_br }}</address>
        {%- if section.settings.map_link != blank -%}<a class="db-text-link" href="{{ section.settings.map_link }}" target="_blank" rel="noopener">View on Google Maps</a>{%- endif -%}
        <dl><div><dt>Phone</dt><dd><a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></dd></div><div><dt>Email</dt><dd><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></dd></div><div><dt>Opening hours</dt><dd>{{ section.settings.hours | newline_to_br }}</dd></div></dl>
      </aside>
      <div class="os-contact__form-wrap"><h2>{{ section.settings.form_heading }}</h2>
        {%- form 'contact', class: 'os-contact__form' -%}
          {%- if form.posted_successfully? -%}<p class="os-contact__success" tabindex="-1">Thanks for getting in touch. Our Christchurch team will reply as soon as possible.</p>{%- endif -%}
          {{ form.errors | default_errors }}
          <div class="os-contact__fields"><label>Name<input name="contact[name]" value="{{ form.name }}" autocomplete="name"></label><label>Email *<input type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></label><label>Phone<input type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel"></label><label>Subject<input name="contact[subject]" value="{{ form.subject }}"></label><label class="os-contact__message">Your message<textarea name="contact[body]" rows="7" required>{{ form.body }}</textarea></label></div>
          <button class="db-button" type="submit">{{ section.settings.button_label }}</button>
        {%- endform -%}
      </div>
    </div>
    <div class="os-contact__more"><p class="db-kicker">Thoughtful gifting</p><h2>{{ section.settings.more_heading }}</h2><div class="db-rte">{{ section.settings.more_text }}</div></div>
  </div>
</section>
{% stylesheet %}
.os-contact{background:var(--os-contact-bg);color:var(--os-contact-text);padding-block:var(--db-section-pad-top) var(--db-section-pad-bottom)}.os-contact__inner{max-width:var(--os-contact-width);padding-block:0}.os-contact__intro{max-width:850px}.os-contact__intro h1{font-family:var(--db-display);font-size:clamp(52px,7vw,100px);font-weight:400;line-height:.95}.os-contact__intro .db-rte{font-size:18px;margin-top:24px}.os-contact__grid{display:grid;gap:clamp(50px,8vw,130px);grid-template-columns:minmax(280px,.7fr) 1.3fr;margin-top:70px}.os-contact__grid h2,.os-contact__more h2{font-family:var(--db-display);font-size:clamp(30px,3vw,48px);font-weight:400}.os-contact__details address{font-style:normal;line-height:1.8;margin-top:28px}.os-contact__details dl{display:grid;gap:24px;margin-top:38px}.os-contact__details dl div{border-top:1px solid currentColor;padding-top:14px}.os-contact__details dt{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.os-contact__details dd{margin:6px 0 0}.os-contact__fields{display:grid;gap:20px;grid-template-columns:1fr 1fr;margin-top:28px}.os-contact__fields label{font-size:13px}.os-contact__fields input,.os-contact__fields textarea{background:transparent;border:0;border-bottom:1px solid currentColor;border-radius:0;color:inherit;display:block;margin-top:7px;padding:12px 0;width:100%}.os-contact__fields textarea{border:1px solid currentColor;padding:14px}.os-contact__message{grid-column:1/-1}.os-contact__form .db-button{margin-top:24px}.os-contact__success{background:var(--db-blush);padding:16px}.os-contact__more{border-top:1px solid currentColor;margin-top:100px;max-width:900px;padding-top:50px}.os-contact__more .db-rte{margin-top:18px}
@media(max-width:749px){.os-contact__grid{grid-template-columns:1fr;margin-top:45px}.os-contact__fields{grid-template-columns:1fr}.os-contact__message{grid-column:auto}.os-contact__more{margin-top:70px}}
{% endstylesheet %}

