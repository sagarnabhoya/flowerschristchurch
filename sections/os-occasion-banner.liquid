{% render 'os-section-style', section: section %}
<section id="os-occasion-banner-{{ section.id }}" class="os-occasion-banner full-width db-section-layout" style="background:{{ section.settings.background }}">
  {% render 'os-section-background', section: section %}
  <div class="db-section-shell db-section-shell--{{ section.settings.content_width | default: 'full' }}">
    <a class="os-occasion-banner__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.accessibility_label | escape }}" style="--os-banner-height:{{ section.settings.desktop_height }}px;--os-banner-mobile-height:{{ section.settings.mobile_height }}px;--os-banner-position:{{ section.settings.desktop_position }};--os-banner-mobile-position:{{ section.settings.mobile_position }}">
      {%- if section.settings.desktop_image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}<source media="(max-width:749px)" srcset="{{ section.settings.mobile_image | image_url: width: 1000 }}">{%- endif -%}
          {{ section.settings.desktop_image | image_url: width: 2600 | image_tag: widths: '750,1100,1500,2000,2600', sizes: '100vw', loading: 'lazy', alt: section.settings.desktop_image.alt | default: section.settings.accessibility_label }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
  </div>
</section>

{% stylesheet %}
.os-occasion-banner__link { display: block; height: var(--os-banner-height); overflow: hidden; }
.os-occasion-banner__link picture, .os-occasion-banner__link img, .os-occasion-banner__link svg { display: block; height: 100%; width: 100%; }
.os-occasion-banner__link img, .os-occasion-banner__link svg { object-fit: cover; object-position: var(--os-banner-position); }
@media (max-width: 749px) {
  .os-occasion-banner__link { height: var(--os-banner-mobile-height); }
  .os-occasion-banner__link img, .os-occasion-banner__link svg { object-position: var(--os-banner-mobile-position); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Occasion image banner",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Uses the desktop image when left empty." },
    { "type": "url", "id": "link", "label": "Banner link" },
    { "type": "text", "id": "accessibility_label", "label": "Accessible link label", "default": "Shop occasions" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 320, "max": 900, "step": 20, "unit": "px", "default": 640 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 140, "max": 640, "step": 10, "unit": "px", "default": 260 },
    { "type": "select", "id": "desktop_position", "label": "Desktop image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "select", "id": "mobile_position", "label": "Mobile image position", "default": "center center", "options": [{ "value": "left center", "label": "Left" }, { "value": "center center", "label": "Center" }, { "value": "right center", "label": "Right" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }] },
    { "type": "color", "id": "background", "label": "Section background", "default": "#fffaf3" },
    { "type": "header", "content": "Section layout" },
    { "type": "select", "id": "content_width", "label": "Content width", "default": "full", "options": [{ "value": "contained", "label": "Container" }, { "value": "fluid", "label": "Container fluid" }, { "value": "full", "label": "Full width" }, { "value": "custom", "label": "Custom width" }] },
    { "type": "range", "id": "custom_width", "label": "Custom width", "min": 600, "max": 2000, "step": 20, "unit": "px", "default": 1600 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"image_picker","id":"mobile_background_image","label":"Mobile background image","info":"Uses the desktop background image when empty."},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_top","label":"Desktop top margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_top","label":"Mobile top margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0}
  ],
  "presets": [{ "name": "Occasion image banner" }]
}
{% endschema %}
