<section class="db-search-page full-width">
  <header class="db-inner-hero"><div class="db-page"><p class="db-kicker">Find the right flowers</p><h1 class="db-title">What are you looking for?</h1><form class="db-search-page__form" action="{{ routes.search_url }}"><label class="visually-hidden" for="SearchPageInput">Search products</label><input id="SearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search flowers, gifts and occasions"><input type="hidden" name="type" value="product"><button type="submit" aria-label="Search">{% render 'icon', name: 'search', class: 'db-header__icon' %}</button></form></div></header>
  {%- if search.performed -%}<div class="db-page db-section"><div class="db-search-results-head"><p class="db-kicker">Search results</p><h2>{% if search.results_count > 0 %}{{ search.results_count }} matches for “{{ search.terms }}”{% else %}No matches just yet{% endif %}</h2></div>{%- if search.results_count > 0 -%}{%- paginate search.results by 16 -%}<ul class="db-product-grid" role="list">{%- for item in search.results -%}{%- if item.object_type == 'product' -%}<li>{% render 'product-card', product: item, show_description: false, show_quick_add: true %}</li>{%- endif -%}{%- endfor -%}</ul>{%- render 'pagination', paginate: paginate -%}{%- endpaginate -%}{%- else -%}<div class="db-empty"><p class="db-copy">Try a flower name, an occasion, or browse everything our florists are making.</p><a class="db-button" href="{{ routes.all_products_collection_url }}">Shop all flowers</a></div>{%- endif -%}</div>{%- endif -%}
</section>
{% schema %}{ "name": "Editorial search", "settings": [] }{% endschema %}
