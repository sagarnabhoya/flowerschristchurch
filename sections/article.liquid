<article class="db-article"><p class="db-article__meta">{{ article.published_at | date: '%B %d, %Y' }} · {{ article.author }}</p><h1>{{ article.title }}</h1>{%- if article.image -%}{{ article.image | image_url: width: 1600 | image_tag: widths: '700,1100,1600', sizes: 'min(100vw, 840px)', class: 'db-article__image', alt: article.title }}{%- endif -%}<div class="db-rte">{{ article.content }}</div></article>
{% schema %}{ "name": "Editorial article", "settings": [] }{% endschema %}
