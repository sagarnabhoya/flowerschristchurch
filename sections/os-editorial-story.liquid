{% render 'os-section-style', section: section %}
<section class="db-editorial full-width db-section-layout db-section-layout--content-{{ section.settings.content_width }}{% if section.settings.image_position == 'right' %} db-editorial--reverse{% endif %}" style="background:{{ section.settings.background }};padding-block:var(--db-section-pad-top) var(--db-section-pad-bottom)">
  {% render 'os-section-background', section: section %}
  <div class="db-editorial__media" {% if section.settings.image_position == 'right' %}style="order:2"{% endif %}>{%- assign fallback_story_image = collections.all.products[1].featured_image | default: collections.all.products.first.featured_image -%}{%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1800 | image_tag: widths: '750,1100,1500,1800', sizes: '(min-width:750px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image_alt }}{%- elsif fallback_story_image -%}{{ fallback_story_image | image_url: width: 1800 | image_tag: widths: '750,1100,1500,1800', sizes: '(min-width:750px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image_alt }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}</div>
  <div class="db-editorial__content" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}"><p class="db-kicker">{{ section.settings.eyebrow }}</p><h2 class="db-title">{{ section.settings.heading }}</h2><div class="db-copy">{{ section.settings.copy }}</div>{%- if section.settings.button_label != blank -%}<a class="db-button db-button--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }} →</a>{%- endif -%}</div>
</section>
{% schema %}
{
  "name": "Editorial image story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" }, { "type": "text", "id": "image_alt", "label": "Image description" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made differently" }, { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Handmade by florists, <em>different daily.</em>" },
    { "type": "richtext", "id": "copy", "label": "Text", "default": "<p>We let the season lead, selecting the freshest stems and arranging every bouquet with its own personality.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" }, { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "color", "id": "background", "label": "Background", "default": "#123f37" },{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"image_picker","id":"mobile_background_image","label":"Mobile background image","info":"Uses the desktop background image when empty."},{"type":"select","id":"content_width","label":"Content width","default":"full","options":[{"value":"contained","label":"Container"},{"value":"fluid","label":"Container fluid"},{"value":"full","label":"Full width"},{"value":"custom","label":"Custom width"}]},{"type":"range","id":"custom_width","label":"Custom width","min":600,"max":2000,"step":20,"unit":"px","default":1600},{"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_top","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_padding_bottom","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_top","label":"Desktop top margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"margin_bottom","label":"Desktop bottom margin","min":0,"max":160,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_top","label":"Mobile top margin","min":0,"max":120,"step":4,"unit":"px","default":0},{"type":"range","id":"mobile_margin_bottom","label":"Mobile bottom margin","min":0,"max":120,"step":4,"unit":"px","default":0}, { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Editorial image story" }]
}
{% endschema %}
