[
  {
    "name": "theme_info",
    "theme_name": "Christchurch Flowers",
    "theme_version": "1.0.0",
    "theme_author": "Custom Skeleton Studio",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 190 },
      { "type": "text", "id": "brand_tagline", "label": "Brand tagline", "default": "Flowers made daily, for life's little moments." }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFAF3",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#193E36",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 18
      }
    ]
  },
  {
    "name": "Editorial palette",
    "settings": [
      { "type": "color", "id": "color_cream", "label": "Cream", "default": "#F7F0E7" },
      { "type": "color", "id": "color_blush", "label": "Blush", "default": "#EFC9C5" },
      { "type": "color", "id": "color_pink", "label": "Pink", "default": "#DA8F96" },
      { "type": "color", "id": "color_red", "label": "Accent red", "default": "#BB3F4B" },
      { "type": "color", "id": "color_green", "label": "Deep green", "default": "#123F37" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "checkbox", "id": "enable_cart_drawer", "label": "Enable cart drawer", "default": false, "info": "When disabled, cart actions continue to the cart page." }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "select", "id": "card_style", "label": "Card style", "default": "editorial", "options": [{ "value": "editorial", "label": "Editorial" }, { "value": "card", "label": "Card" }, { "value": "minimal", "label": "Minimal" }] },
      { "type": "select", "id": "card_image_ratio", "label": "Image ratio", "default": "0.77", "options": [{ "value": "1", "label": "Square" }, { "value": "1.333", "label": "Landscape" }, { "value": "0.82", "label": "Portrait" }, { "value": "0.77", "label": "Reference portrait" }] },
      { "type": "select", "id": "card_image_fit", "label": "Image fit", "default": "cover", "options": [{ "value": "cover", "label": "Cover" }, { "value": "contain", "label": "Contain" }, { "value": "none", "label": "Original" }] },
      { "type": "range", "id": "card_corner_radius", "label": "Image corner radius", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 10 },
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "card_show_description", "label": "Show product descriptions", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "Show quick-add buttons", "default": false },
      { "type": "range", "id": "card_title_size", "label": "Title size", "min": 14, "max": 30, "step": 1, "unit": "px", "default": 20 },
      { "type": "range", "id": "card_title_lines", "label": "Title lines", "min": 1, "max": 4, "step": 1, "default": 2 },
      { "type": "range", "id": "card_description_size", "label": "Description size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 12 },
      { "type": "range", "id": "card_description_lines", "label": "Description lines", "min": 1, "max": 6, "step": 1, "default": 2 },
      { "type": "range", "id": "card_price_size", "label": "Price size", "min": 11, "max": 22, "step": 1, "unit": "px", "default": 14 },
      { "type": "range", "id": "card_badge_size", "label": "Flower badge size", "min": 44, "max": 100, "step": 2, "unit": "px", "default": 72 },
      { "type": "select", "id": "card_badge_position", "label": "Badge position", "default": "right", "options": [{ "value": "left", "label": "Top left" }, { "value": "right", "label": "Top right" }] },
      { "type": "color", "id": "card_badge_color", "label": "Badge background", "default": "#ef493e" },
      { "type": "color", "id": "card_badge_text_color", "label": "Badge text", "default": "#ffffff" },
      { "type": "text", "id": "card_default_badge", "label": "Default badge text", "info": "Optional fallback when a product has no custom badge." },
      { "type": "checkbox", "id": "card_show_badges", "label": "Show product badges", "default": true },
      { "type": "checkbox", "id": "card_show_auto_new", "label": "Automatically label recent products", "default": true },
      { "type": "range", "id": "card_new_product_days", "label": "Product remains new for", "min": 15, "max": 365, "step": 10, "unit": "day", "default": 55 },
      { "type": "text", "id": "card_new_badge_label", "label": "New badge text", "default": "New!" },
      { "type": "header", "content": "SVG badge mapping" },
      { "type": "paragraph", "content": "Per-product metafields: custom.card_badge (label), custom.card_badge_type (new, locally-grown or custom), and custom.card_badge_svg (custom SVG markup). Metafields override tag mappings." },
      { "type": "text", "id": "card_badge_local_tag", "label": "Locally grown product tag", "default": "locally grown" },
      { "type": "text", "id": "card_badge_new_tag", "label": "New product tag", "default": "new" },
      { "type": "textarea", "id": "card_badge_local_svg", "label": "Custom locally grown SVG", "info": "Optional. Leave empty to use the built-in locally grown SVG." },
      { "type": "textarea", "id": "card_badge_new_svg", "label": "Custom new SVG", "info": "Optional. Leave empty to use the built-in NEW SVG." }
    ]
  },
  {
    "name": "Product badge mappings",
    "settings": [
      { "type": "paragraph", "content": "Map up to five exact product tags to custom badge labels and SVG markup. Product metafields override these mappings." },
      { "type": "header", "content": "Mapping 1" },
      { "type": "text", "id": "card_badge_map_1_tag", "label": "Product tag" },
      { "type": "text", "id": "card_badge_map_1_label", "label": "Accessible badge label" },
      { "type": "textarea", "id": "card_badge_map_1_svg", "label": "SVG markup" },
      { "type": "header", "content": "Mapping 2" },
      { "type": "text", "id": "card_badge_map_2_tag", "label": "Product tag" },
      { "type": "text", "id": "card_badge_map_2_label", "label": "Accessible badge label" },
      { "type": "textarea", "id": "card_badge_map_2_svg", "label": "SVG markup" },
      { "type": "header", "content": "Mapping 3" },
      { "type": "text", "id": "card_badge_map_3_tag", "label": "Product tag" },
      { "type": "text", "id": "card_badge_map_3_label", "label": "Accessible badge label" },
      { "type": "textarea", "id": "card_badge_map_3_svg", "label": "SVG markup" },
      { "type": "header", "content": "Mapping 4" },
      { "type": "text", "id": "card_badge_map_4_tag", "label": "Product tag" },
      { "type": "text", "id": "card_badge_map_4_label", "label": "Accessible badge label" },
      { "type": "textarea", "id": "card_badge_map_4_svg", "label": "SVG markup" },
      { "type": "header", "content": "Mapping 5" },
      { "type": "text", "id": "card_badge_map_5_tag", "label": "Product tag" },
      { "type": "text", "id": "card_badge_map_5_label", "label": "Accessible badge label" },
      { "type": "textarea", "id": "card_badge_map_5_svg", "label": "SVG markup" }
    ]
  }
]
