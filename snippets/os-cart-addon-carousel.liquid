{%- assign carousel_products = products | default: collection.products -%}
<section class="os-cart-addons" style="--os-addon-radius:{{ card_radius }}px"><header><h2>{{ heading }}</h2>{%- if subheading != blank -%}<p>{{ subheading }}</p>{%- endif -%}</header><os-cart-carousel class="os-cart-carousel"><div class="os-cart-carousel__track" data-cart-carousel-track tabindex="0" role="region" aria-label="{{ heading | escape }}">{%- for product in carousel_products limit: limit -%}{%- assign variant = product.selected_or_first_available_variant -%}<article class="os-cart-addon" data-cart-carousel-cell><a class="os-cart-addon__media" href="{{ product.url }}">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 700 | image_tag: widths: '240,360,500,700', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{%- endif -%}{%- if product.images[1] != blank -%}{{ product.images[1] | image_url: width: 700 | image_tag: widths: '240,360,500,700', loading: 'lazy', alt: product.images[1].alt | default: product.title, class: 'os-cart-addon__secondary' }}{%- endif -%}</a><h3><a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title }}</a></h3><p>{{ variant.price | money }}</p><button type="button" data-cart-addon="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}Add +{% else %}Sold out{% endif %}</button></article>{%- endfor -%}</div><div class="os-cart-carousel__navigation" data-cart-carousel-navigation role="group" aria-label="{{ heading | escape }} navigation" hidden>
<button class="os-cart-carousel__arrow os-cart-carousel__arrow--prev" type="button" data-cart-carousel-prev aria-label="Previous {{ heading | escape }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="m14 6-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
<button class="os-cart-carousel__arrow os-cart-carousel__arrow--next" type="button" data-cart-carousel-next aria-label="Next {{ heading | escape }}"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="m10 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
</div></os-cart-carousel></section>
