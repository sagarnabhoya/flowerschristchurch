<section class="os-cart-addons" style="--os-addon-radius:{{ card_radius }}px"><header><h2>{{ heading }}</h2>{%- if subheading != blank -%}<p>{{ subheading }}</p>{%- endif -%}</header><os-cart-carousel class="os-cart-carousel"><div class="os-cart-carousel__track" data-cart-carousel-track>{%- for product in collection.products limit: limit -%}{%- assign variant = product.selected_or_first_available_variant -%}<article class="os-cart-addon" data-cart-carousel-cell><a class="os-cart-addon__media" href="{{ product.url }}">{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 700 | image_tag: widths: '240,360,500,700', loading: 'lazy', alt: product.featured_image.alt | default: product.title }}{%- endif -%}{%- if product.images[1] != blank -%}{{ product.images[1] | image_url: width: 700 | image_tag: widths: '240,360,500,700', loading: 'lazy', alt: product.images[1].alt | default: product.title, class: 'os-cart-addon__secondary' }}{%- endif -%}</a><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><p>{{ variant.price | money }}</p><button type="button" data-cart-addon="{{ variant.id }}"{% unless variant.available %} disabled{% endunless %}>{% if variant.available %}Add +{% else %}Sold out{% endif %}</button></article>{%- endfor -%}</div><button class="os-cart-carousel__arrow os-cart-carousel__arrow--prev" type="button" data-cart-carousel-prev aria-label="Previous">‹</button><button class="os-cart-carousel__arrow os-cart-carousel__arrow--next" type="button" data-cart-carousel-next aria-label="Next">›</button></os-cart-carousel></section>
