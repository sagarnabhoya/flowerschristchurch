    "seo": {
      "type": "os-rich-content",
      "settings": {
        "content": "<h1><strong>Christchurch flowers, handcrafted locally.</strong></h1><p>Flowers Across Christchurch brings fresh, thoughtfully arranged flowers to doorsteps across the city. From birthdays and anniversaries to sympathy flowers and spontaneous gestures, our local team prepares each order with care.</p><h1><strong>Christchurch Flower Delivery &nbsp;</strong></h1><p>Browse bouquets, roses, flower boxes, arrangements, plants and thoughtful extras online. Select the flowers for the moment, provide the recipient and delivery details, and our Christchurch team will take care of the rest.&nbsp;</p><p>Same-day and weekend availability depends on the suburb, selected product and order time. Current delivery choices and charges are confirmed during checkout.</p>",
        "background": "#fffaf3",
        "text_color": "#41511d",
        "content_width": "custom",
        "custom_width": 960,
        "padding_top": 36,
        "padding_bottom": 72,
        "mobile_padding_top": 20,
        "mobile_padding_bottom": 64,
        "margin_top": 0,
        "margin_bottom": 0,
        "mobile_margin_top": 0,
        "mobile_margin_bottom": 0
      }
    },
    "os_faq_page_rKPVP9": {
      "type": "os-faq-page",
      "blocks": {
        "question_free_delivery": {
          "type": "question",
          "disabled": true,
          "settings": {
            "question": "Do you offer FREE Flower Delivery in Christchurch?",
            "answer": "<p>Yes. Flower Across Christchurch proudly offers FREE Flower Delivery in Christchurch to most Christchurch suburbs.</p>"
          }
        },
        "question_same_day": {
          "type": "question",
          "settings": {
            "question": "Do you offer same-day flower delivery?",
            "answer": "<p>Yes. We offer same-day flower delivery to eligible Christchurch suburbs when you place your order before our daily cut-off time.</p>"
          }
        },
        "question_areas": {
          "type": "question",
          "settings": {
            "question": "Which areas in Christchurch do you deliver to?",
            "answer": "<p>We deliver citywide! Our reliable delivery network covers all major Christchurch suburbs, including Riccarton, Merivale, St Albans, Papanui, Fendalton, Bryndwr, Avonhead, Sumner, New Brighton, Halswell, and surrounding Canterbury areas.</p>"
          }
        },
        "question_d9MKYE": {
          "type": "question",
          "settings": {
            "question": "Christchurch Hospital Flowers delivery",
            "answer": "<p><strong>The following wards do not accept fresh flowers in the Christchurch Public Hospital:</strong></p><p>Wards 10, 11, 17, 18, 20, 24, 25, A3, A4, A5, A8, B3, B4, B8, AMAU, BMTU, CHOC, CICU, DOSA, DSU, ICU, PHDU and UU.</p><p>Christchurch Women’s Hospital will only accept flowers for the Gynaecology ward.</p><p>Flowers and potted plants are NOT ALLOWED in any wards in Christchurch Women’s Hospital (Gyno ONLY). This includes Maternity Wards and Birthing Suites as well as Community Maternity Units such as Rangiora, Lincoln, Ashburton, Kaikoura and Darfield.</p><p>Burwood Hospital – Flowers and potted plants are NOT ALLOWED in the following wards and units: Admitting Unit, PACU, Progressive Care Unit – please check with ward staff re: Ward FG (Spinal Unit) and Ward CG (Brain Injury)</p><p><strong>Note:</strong>&nbsp;An alternative could be a care package or gift basket for which you can contact our store phone number or email</p>"
          }
        },
        "question_message_gift": {
          "type": "question",
          "settings": {
            "question": "Can I add a personal message or gift to my order?",
            "answer": "<p>Yes! Every flower delivery includes a complimentary boutique message card with your personal note. At checkout, you can also easily add thoughtful gift extras like premium chocolates, teddy bears, or elegant glass vases.</p>"
          }
        },
        "question_delivery_date": {
          "type": "question",
          "settings": {
            "question": "Can I choose a delivery date?",
            "answer": "<p>Yes. You can select your preferred delivery date during checkout, making it easy to organise flowers for birthdays, anniversaries, special occasions, and future celebrations.</p>"
          }
        },
        "question_hospitals": {
          "type": "question",
          "settings": {
            "question": "Do you deliver to hospitals, workplaces, and retirement villages?",
            "answer": "<p>Yes. We deliver flowers to homes, workplaces, hospitals, retirement villages, schools, and other locations throughout Christchurch.</p>"
          }
        },
        "question_not_home": {
          "type": "question",
          "settings": {
            "question": "What if the recipient isn't home?",
            "answer": "<p>If the recipient isn't available, our delivery team will follow any delivery instructions provided with your order or leave the flowers in a safe location whenever appropriate.</p>"
          }
        },
        "question_fresh": {
          "type": "question",
          "settings": {
            "question": "Are your flowers fresh and locally sourced?",
            "answer": "<p>Absolutely. We source our blooms daily from the local Christchurch flower market to ensure maximum freshness, vibrancy, and longevity. Every arrangement is handcrafted with care by our team of expert local florists.</p>"
          }
        },
        "question_sympathy": {
          "type": "question",
          "settings": {
            "question": "Do you provide sympathy and funeral flowers in Christchurch?",
            "answer": "<p>Yes, we understand the importance of these moments. We offer a respectful, dignified range of sympathy bouquets, standing sprays, and funeral tributes, with prompt and reliable delivery to family homes, churches, or funeral parlours across Christchurch.</p>"
          }
        }
      },
