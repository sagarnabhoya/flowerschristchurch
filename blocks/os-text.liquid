<div class="db-copy db-rte" style="text-align:{{ block.settings.alignment }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
{% schema %}
{
  "name": "Editorial text",
  "settings": [
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Thoughtfully selected flowers, made fresh and delivered with care.</p>" },
    { "type": "text_alignment", "id": "alignment", "label": "Alignment", "default": "left" }
  ],
  "presets": [{ "name": "Editorial text" }]
}
{% endschema %}
