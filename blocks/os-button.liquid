<a class="db-button{% if block.settings.style == 'outline' %} db-button--outline{% elsif block.settings.style == 'light' %} db-button--light{% endif %}" {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %} {{ block.shopify_attributes }}>
  {{ block.settings.label | escape }} {% render 'icon', name: 'arrow', class: 'db-header__icon' %}
</a>
{% schema %}
{
  "name": "Editorial button",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Shop blooms" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "style", "label": "Style", "default": "solid", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }, { "value": "light", "label": "Light" }] }
  ],
  "presets": [{ "name": "Editorial button" }]
}
{% endschema %}
