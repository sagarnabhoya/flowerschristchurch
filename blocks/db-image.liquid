<figure style="border-radius:{{ block.settings.radius }}px;overflow:hidden" {{ block.shopify_attributes }}>
  {%- if block.settings.image -%}
    {{ block.settings.image | image_url: width: 1800 | image_tag: widths: '500, 900, 1200, 1800', sizes: '100vw', loading: 'lazy', alt: block.settings.alt }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag }}
  {%- endif -%}
</figure>
{% schema %}
{
  "name": "Editorial image",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "alt", "label": "Image description" },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 }
  ],
  "presets": [{ "name": "Editorial image" }]
}
{% endschema %}
